 // Ocarina submits about 20 small batches a frame in Hyrule Field: with 8 allocators the submit thread blocked on the oldest about 17 times a frame while the GPU sat idle for half of it. DM_NVN_ALLOC_CAP lowers the cap (and the visibility ring's, which is one per submission) to compare.
 static int alloc_cap(void) { static int v; if (!v) { const char *e = getenv("DM_NVN_ALLOC_CAP"); int n = e ? atoi(e) : ALLOC_MAX; v = n < 3 ? 3 : n > ALLOC_MAX ? ALLOC_MAX : n; } return v; }
 static id<MTL4CommandAllocator> g_alloc4[ALLOC_MAX]; static int g_alloc_n, g_alloc_cur;   // Command allocator pool of the main submission: at start pick one the GPU has finished with, create a new one if there is none (wait only at the cap)
-static id<MTL4CommandAllocator> g_up_alloc4[3];
+#define UP_SLOTS 8
+// Ocarina of Time makes 1.3 to 1.9 upload batches a frame, more while textures stream in: with 3 slots taken in turn the submit thread waited in up_begin for a batch queued behind the frame's GPU work
+// (M1 Max, walking in Kokiri Forest: the submit step blocked 20 to 50 ms in frames with uploads). DM_NVN_UP_SLOTS lowers the count to compare (3 is the old value)
+static int up_slots(void) { static int v; if (!v) { const char *e = getenv("DM_NVN_UP_SLOTS"); int n = e ? atoi(e) : UP_SLOTS; v = n < 3 ? 3 : n > UP_SLOTS ? UP_SLOTS : n; } return v; }
+static id<MTL4CommandAllocator> g_up_alloc4[UP_SLOTS];   // the first 3 are made at start, the others the first time their slot comes round (up_begin)
 static id<MTL4CommandAllocator> g_present_alloc4[3];
 static id<MTL4CommandBuffer> g_present_cb[3];
 static id<MTL4ArgumentTable> g_vt, g_ft, g_ct, g_up_ct, g_ot;   // g_ot: the object stage of a task / mesh draw (mesh_tasks_draw)
@@ -3002,7 +3006,7 @@
 static _Atomic uint64_t g_upload_gpu_ns;
 static id<MTL4CommandBuffer> g_up_cb;
 static id<MTL4ComputeCommandEncoder> g_up_ce;
-static _Atomic int g_up_alloc_busy[3];
+static _Atomic int g_up_alloc_busy[UP_SLOTS];
 // Waiting for upload batches to finish (g_up_pending, g_up_alloc_busy): the batches' completion handler broadcasts after it updates them, so waiters sleep until then (they used to poll every 0.2–1 ms;
 // Three Houses' loader calls QueueFinish after each resource, each one waited up to a millisecond late). The 10 ms timeout is only a safety net
 static pthread_mutex_t g_up_wmu = PTHREAD_MUTEX_INITIALIZER; static pthread_cond_t g_up_wcv = PTHREAD_COND_INITIALIZER;
@@ -3018,11 +3022,11 @@
 static unsigned g_up_seq;
 #define UP_BLOCK_SIZE (32u * 1024u * 1024u)
