diff --git a/dm/gfx/nvn/nvn_queue.inc b/dm/gfx/nvn/nvn_queue.inc
--- a/dm/gfx/nvn/nvn_queue.inc
+++ b/dm/gfx/nvn/nvn_queue.inc
@@ -191,7 +191,10 @@
             nq_node *n=j->last; if(!n || n->kind!=NQ_COMMANDS || n->closed) n=nq_append(j,NQ_COMMANDS);
             size_t offset=n->length; nq_bytes(n,p,h.size);
             if(!cap_rec_fields(h.op,n->bytes+offset+8,h.size,&nq_snapshot_ops,j)) die("queue snapshot: unknown command %u",h.op);
-            if(h.op==OP_SIGNAL_EVENT) { memcpy(&n->event,a,8); memcpy(&n->mode,a+8,4); memcpy(&n->value,a+12,4); nq_end(j); nq_append(j,NQ_FENCE)->receipt=nq_new(); }
+            // A signal stays in the segment: its value publishes at submission completion (mtl_sub_event's post op) and a
+            // waiter is ordered by that value, so a mid-segment fence buys nothing. Ending the segment here ended the open
+            // render pass at every signal: one pass per occlusion query, for an engine that signals per query.
+            if(h.op==OP_SIGNAL_EVENT) { memcpy(&n->event,a,8); memcpy(&n->mode,a+8,4); memcpy(&n->value,a+12,4); }
         }
         p+=h.size;
     }
