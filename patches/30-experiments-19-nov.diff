+        CHECK(bad == 0); if (bad) fprintf(stderr, "  target %d: %d bytes differ with pieces on, first at pixel (%d,%d): %u vs %u\n", k, bad, first / 4 % 64, first / 4 / 64, g_px[0][k][first], g_px[1][k][first]);
