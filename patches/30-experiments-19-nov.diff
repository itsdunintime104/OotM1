+static prog_t g_cwrite; static chain g_pcA1, g_pcA2;
+static pool_t g_apool; static tex_t g_at;   // their target, with pool storage as a game's (one without counts as overlapping the window: acs_rt_hit)
+static void avbuf(chain *c, uint32_t size) { p_bind_vbuf1 *v = emit(c, OP_BIND_VBUF1, sizeof *v); *v = (p_bind_vbuf1){0, size, size ? (uint64_t)(uintptr_t)(g_pool + AOFF) : 0}; }
