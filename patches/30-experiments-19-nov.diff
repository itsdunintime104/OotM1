 // uniform update: the data is copied into command memory at record time (NVN semantics: the caller may modify the original data after recording) and written into the buffer at submit
+// DM_NVN_BUFLOG=1 (diagnostic, off by default; it draws nothing differently): which buffer ranges a frame binds does the game write again while it builds the next frame?
+// The pools are zero-copy (the GPU reads a range's content when the draw runs), so such a range is safe only while the game waits for the GPU before it builds the next frame.
+// Once every 300 frames: frame A's bound ranges are collected (uniform, vertex, storage, index, indirect arguments), read at A's present (first 64 KB of each, through
+// mach_vm_read_overwrite, so a range that is not mapped counts as unreadable), and read again at the next present. A range whose content differs was rewritten in place.
+uint64_t dm_nvn_frame_count(void);
+#include <mach/mach_vm.h>
+#define BL_N 32768
+static struct { uint64_t a; uint32_t n, kind; uint64_t h; } bl_t[BL_N];
+static _Atomic int bl_collect; static int bl_state, bl_used, bl_drop; static pthread_mutex_t bl_mu = PTHREAD_MUTEX_INITIALIZER;
+static const char *const bl_kind[5] = {"uniform", "vertex", "storage", "index", "indirect arguments"};
+static int bl_on(void) { static int on = -1; if (on < 0) { const char *e = getenv("DM_NVN_BUFLOG"); on = e && atoi(e); if (on) LOG("[buflog] DM_NVN_BUFLOG: bound buffer ranges rewritten in place, one frame pair in every 300"); } return on; }
+static void bl_note(unsigned kind, uint64_t a, uint64_t n) {
+    if (!atomic_load_explicit(&bl_collect, memory_order_relaxed) || !a || !n) return;
+    if (n > 65536) n = 65536;
+    pthread_mutex_lock(&bl_mu);
+    uint32_t i = (uint32_t)((a * 0x9E3779B97F4A7C15ull) >> 49) & (BL_N - 1);
+    for (int k = 0; k < 64; k++, i = (i + 1) & (BL_N - 1)) {
+        if (bl_t[i].a == a && bl_t[i].kind == kind) { if (bl_t[i].n < n) bl_t[i].n = (uint32_t)n; goto out; }
+        if (!bl_t[i].a) { bl_t[i].a = a; bl_t[i].n = (uint32_t)n; bl_t[i].kind = kind; bl_used++; goto out; }
+    }
+    bl_drop++;
+out: pthread_mutex_unlock(&bl_mu);
+}
+static int bl_hash(uint64_t a, uint32_t n, uint64_t *h) {   // 0 when the range cannot be read
+    static uint8_t buf[65536]; mach_vm_size_t got = 0;
+    if (mach_vm_read_overwrite(mach_task_self(), (mach_vm_address_t)a, n, (mach_vm_address_t)(uintptr_t)buf, &got) != KERN_SUCCESS || got != n) return 0;
+    uint64_t x = 0xcbf29ce484222325ull; for (uint32_t i = 0; i < n; i++) { x ^= buf[i]; x *= 0x100000001b3ull; } *h = x ? x : 1; return 1;
+}
+static void bl_present(void) {   // called at each present, on the presenting thread
+    if (!bl_on()) return;
+    uint64_t f = dm_nvn_frame_count();
+    if (bl_state == 0) { if (f > 900 && f % 300 == 0) { pthread_mutex_lock(&bl_mu); memset(bl_t, 0, sizeof bl_t); bl_used = bl_drop = 0; pthread_mutex_unlock(&bl_mu); atomic_store(&bl_collect, 1); bl_state = 1; } return; }
+    if (bl_state == 1) {   // end of frame A: its ranges are complete; read them
+        atomic_store(&bl_collect, 0); pthread_mutex_lock(&bl_mu);
+        for (int i = 0; i < BL_N; i++) if (bl_t[i].a && !bl_hash(bl_t[i].a, bl_t[i].n, &bl_t[i].h)) bl_t[i].h = 0;
+        pthread_mutex_unlock(&bl_mu); bl_state = 2; return;
+    }
+    // end of frame A + 1: read them again
+    unsigned cnt[5] = {0}, chg[5] = {0}, bad = 0; uint64_t by[5] = {0}, cby[5] = {0};
+    struct { uint64_t a; uint32_t n, kind; } top[8]; int nt = 0;
+    pthread_mutex_lock(&bl_mu);
+    for (int i = 0; i < BL_N; i++) { if (!bl_t[i].a) continue;
+        unsigned k = bl_t[i].kind; uint64_t h = 0;
+        if (!bl_t[i].h || !bl_hash(bl_t[i].a, bl_t[i].n, &h)) { bad++; continue; }
+        cnt[k]++; by[k] += bl_t[i].n;
+        if (h != bl_t[i].h) { chg[k]++; cby[k] += bl_t[i].n;
+            if (nt < 8) { top[nt].a = bl_t[i].a; top[nt].n = bl_t[i].n; top[nt].kind = k; nt++; }
+            else { int m = 0; for (int j = 1; j < 8; j++) if (top[j].n < top[m].n) m = j; if (top[m].n < bl_t[i].n) { top[m].a = bl_t[i].a; top[m].n = bl_t[i].n; top[m].kind = k; } } }
+    }
+    int used = bl_used, drop = bl_drop; pthread_mutex_unlock(&bl_mu);
+    LOG("[buflog] F%llu: %d ranges bound in the frame before (%d more not kept, %u unreadable); rewritten in place by the next present:", (unsigned long long)f, used, drop, bad);
+    for (int k = 0; k < 5; k++) LOG("[buflog]   %-18s %5u of %5u ranges, %7llu of %8llu KB (first 64 KB of each)", bl_kind[k], chg[k], cnt[k], (unsigned long long)(cby[k] >> 10), (unsigned long long)(by[k] >> 10));
+    for (int j = 0; j < nt; j++) LOG("[buflog]   rewritten: %s %#llx + %u", bl_kind[top[j].kind], (unsigned long long)top[j].a, top[j].n);
+    bl_state = 0;
+}
