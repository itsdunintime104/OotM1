+           (unsigned long long)np, np ? (double)(s2[PCS_DRAWS] - s1[PCS_DRAWS]) / (double)np : 0.0, (unsigned long long)nc, (unsigned long long)(s2[PCS_PLANNED] - s1[PCS_PLANNED]),
