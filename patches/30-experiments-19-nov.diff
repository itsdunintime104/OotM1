@@ -1174,6 +1175,65 @@ static uint8_t *cmd_alloc(cmd_t *o, uint32_t size) { return cmd_alloc_keep(o, si
 // A recording starts with its first command, as in NVN: no BEGIN record, so an empty recording takes only its END. Games size command memory by GetCommandMemoryUsed
 // (nvn_obj.h draw_rec): Breath of the Wild sums one scratch recording per mesh and per shape and render pass into each model's prerecorded commands, and with an
 // 8-byte BEGIN on each of several hundred recordings a model came out a 4 KB page over its resource size table entry
+// DM_NVN_SUBWATCH=1 (diagnostic, off by default; it draws nothing differently): is a uniform range written again after the game submitted the commands that read it, and in
+// which frame? One frame in every 500 (after frame 2000), frame A: each uniform bind is noted with the recording it is in (the handle EndRecording will return; a recording
+// called from another through CopyCommands follows its caller). When a submit carries that recording the range's pages are write-protected and the time is taken. The fault
+// handler records every write with its thread and program counter (nvn_dirty_watch) until the present of frame A + 1. A write inside a range after its submit is counted as
+// "same frame" when it comes before frame A's present, else "next frame". A page is watched again only at a later submit that carries a range on it: the counts are lower bounds.
+uint64_t dm_nvn_frame_count(void);
+enum { SW_N = 16384, SW_C = 4096 };
+static struct { uint64_t a, h, t_sub; uint32_t n; } sw_r[SW_N]; static int sw_n, sw_nc, sw_state;   // sw_state: 0 off, 1 frame A (binds and submits noted), 2 frame A + 1 (writes still recorded)
+static struct { uint64_t child, parent; } sw_call[SW_C];
+static _Atomic int sw_collect, sw_live; static pthread_mutex_t sw_mu = PTHREAD_MUTEX_INITIALIZER; static uint64_t sw_t_a;   // sw_t_a: the time of frame A's present
+static int sw_on(void) { static int on = -1; if (on < 0) { const char *e = getenv("DM_NVN_SUBWATCH"); on = e && atoi(e); if (on) LOG("[subwatch] DM_NVN_SUBWATCH: writes into uniform ranges after their submit, one frame in every 500"); } return on; }
+static void sw_bind(uint64_t handle, uint64_t a, uint64_t n) {
+    if (!atomic_load_explicit(&sw_collect, memory_order_relaxed) || !a || !n || n > 65536) return;
+    pthread_mutex_lock(&sw_mu); if (sw_n < SW_N) { sw_r[sw_n].a = a; sw_r[sw_n].n = (uint32_t)n; sw_r[sw_n].h = handle; sw_r[sw_n].t_sub = 0; sw_n++; } pthread_mutex_unlock(&sw_mu);
+}
+static void sw_called(uint64_t parent, uint64_t child) {
+    if (!atomic_load_explicit(&sw_collect, memory_order_relaxed)) return;
+    pthread_mutex_lock(&sw_mu); if (sw_nc < SW_C) { sw_call[sw_nc].child = child; sw_call[sw_nc].parent = parent; sw_nc++; } pthread_mutex_unlock(&sw_mu);
+}
+static void sw_submit(int n, const uint64_t *h) {   // n = 0: only protect the submitted ranges again (a page is writable again after its first write)
+    if (!atomic_load_explicit(&sw_live, memory_order_relaxed)) return;
+    pthread_mutex_lock(&sw_mu); uint64_t t = mach_absolute_time();
+    for (int i = 0; i < sw_n; i++) { if (sw_r[i].t_sub) continue;
+        uint64_t x = sw_r[i].h; int sub = 0;
+        for (int depth = 0; depth < 8 && !sub; depth++) { for (int k = 0; k < n; k++) if (h[k] == x) sub = 1;
+            if (sub) break; int found = 0; for (int k = sw_nc - 1; k >= 0; k--) if (sw_call[k].child == x) { x = sw_call[k].parent; found = 1; break; } if (!found) break; }
+        if (sub) sw_r[i].t_sub = t; }
+    for (int i = 0; i < sw_n; i++) if (sw_r[i].t_sub) nvn_dirty_protect((const void *)sw_r[i].a, sw_r[i].n);
+    pthread_mutex_unlock(&sw_mu);
+}
+static void sw_report(uint64_t t_end) {
+    static mach_timebase_info_data_t tb; if (!tb.denom) mach_timebase_info(&tb);
+    const nvn_dirty_wfault *f; unsigned seen = 0, nf = nvn_dirty_watch_get(&f, &seen);
+    struct { void *th; uintptr_t pc; unsigned same, next; uint32_t n; uint64_t off; double ms_same, ms_next; } top[48]; int nt = 0; unsigned same = 0, next = 0, before = 0; int unsub = 0, late = 0;
+    pthread_mutex_lock(&sw_mu);
+    for (int i = 0; i < sw_n; i++) { unsub += !sw_r[i].t_sub; late += sw_r[i].t_sub > sw_t_a; }
+    for (unsigned i = 0; i < nf; i++) { int hit = -1, pre = 0;
+        for (int j = sw_n - 1; j >= 0; j--) if (f[i].addr >= sw_r[j].a && f[i].addr < sw_r[j].a + sw_r[j].n) { if (sw_r[j].t_sub && f[i].t > sw_r[j].t_sub) { if (hit < 0 || sw_r[j].t_sub > sw_r[hit].t_sub) hit = j; } else pre = 1; }
+        if (hit < 0) { before += pre; continue; }
+        int is_next = sw_r[hit].t_sub <= sw_t_a && f[i].t > sw_t_a; if (is_next) next++; else same++;   // next: a present lies between the submit and the write
+        int k = 0; for (; k < nt; k++) if (top[k].th == f[i].thread && top[k].pc == f[i].pc) break;
+        if (k == nt) { if (nt == 48) continue; nt++; top[k].th = f[i].thread; top[k].pc = f[i].pc; top[k].same = top[k].next = 0; top[k].n = sw_r[hit].n; top[k].off = f[i].addr - sw_r[hit].a; top[k].ms_same = top[k].ms_next = -1; }
+        double ms = (double)(f[i].t - sw_r[hit].t_sub) * tb.numer / tb.denom / 1e6;
+        if (is_next) { if (!top[k].next++) top[k].ms_next = ms; } else { if (!top[k].same++) top[k].ms_same = ms; }
+    }
+    int ranges = sw_n; pthread_mutex_unlock(&sw_mu);
+    LOG("[subwatch] frame %llu: %d uniform binds noted (%d submitted only after the frame's present, %d in recordings no submit carried), %u write faults (%u recorded); inside a range after its submit: %u with no present between, %u with a present between; %u inside a range before its submit; the frame after lasted %.2f ms",
+        (unsigned long long)dm_nvn_frame_count() - 2, ranges, late, unsub, seen, nf, same, next, before, (double)(t_end - sw_t_a) * tb.numer / tb.denom / 1e6);
+    for (int k = 0; k < nt; k++) { char name[64] = "?"; pthread_getname_np((pthread_t)top[k].th, name, sizeof name);
+        LOG("[subwatch]   thread \"%s\" pc %#lx: no present between %u (first %.3f ms after the submit), a present between %u (first %.3f ms after the submit); first: byte %llu of a %u-byte range",
+            name, (unsigned long)top[k].pc, top[k].same, top[k].ms_same, top[k].next, top[k].ms_next, (unsigned long long)top[k].off, top[k].n); }
+}
+static void sw_present(void) {   // at each present, on the presenting thread
+    if (!sw_on()) return;
+    uint64_t f = dm_nvn_frame_count(), t = mach_absolute_time();
+    if (sw_state == 0) { if (f > 2000 && f % 500 == 0) { pthread_mutex_lock(&sw_mu); sw_n = sw_nc = 0; pthread_mutex_unlock(&sw_mu); nvn_dirty_watch(1); atomic_store(&sw_collect, 1); atomic_store(&sw_live, 1); sw_state = 1; } return; }
+    if (sw_state == 1) { atomic_store(&sw_collect, 0); sw_t_a = t; sw_state = 2; sw_submit(0, NULL); return; }   // frame A's present: no new ranges; writes are recorded for one frame more
+    atomic_store(&sw_live, 0); nvn_dirty_watch(0); sw_report(t); sw_state = 0;
+}
