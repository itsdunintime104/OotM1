+// Mode workers (P3c C3, DM_NVN_PAR_WORKERS): the pieces frame, frame M and frame U, pieces off once (the reference), then for each K in DM_PAR_K (default 1,2,3,4) NITER times
+// with K worker threads: every target's pixels, frame U's filled buffers, report, event word and joined lists equal the reference; every planned cut taken; pieces by workers > 0;
+// none ended out of place. Then a timing frame: 12 passes of 200 draws (DRAWS 200: 11 cuts), the begin-to-commit wall time with pieces on one thread and with K workers
+static uint8_t g_wm[NPT][64 * 64 * 4];
+// Frame X (texture uploads on workers): texture T lives in the pool and is CPU-written (mtl_tex_cpu_written). Piece 0 draws into target 0; piece 1 (a worker's) copies T into
+// target 1's (16,16) and draws; piece 2 draws into target 2. Between two frames the CPU rewrites T's storage, so piece 1 is T's first use after the write: its upload must happen
+// (a worker uploads through its own batch) and reach the queue before piece 1. Frame R (report order): the samples-passed counter reset, then pieces 1 and 2 (workers) both report
+// it into ROFF2 (50 and 125 draws' worth), then piece 3 holds a counter-value render condition on ROFF2 (the replay thread's) and draws: ROFF2 must end as piece 2's report
+enum { TOFF = 0x3c000, ROFF2 = 0x3b100 };
+static tex_t g_wt; static chain g_pcx_x, g_pcx_r;
+static pool_t g_tpool;   // the textures of frames X, Z and Y live in a CPU-cached pool over g_pool, as a game's loaded textures do (tex_from_storage)
+static void wt_fill(int gen) { uint8_t *m = g_pool + TOFF; for (uint64_t i = 0; i < g_wt.L.size; i++) m[i] = (uint8_t)(i * 7 + gen * 91 + 3); }
+static void build_xr(void) {
+    g_tpool = (pool_t){.magic = MAGIC('P', 'O', 'O', 'L'), .flags = NVN_MEMORY_POOL_FLAGS_CPU_CACHED | NVN_MEMORY_POOL_FLAGS_GPU_CACHED, .mem = g_pool, .size = 256 << 10};
+    g_wt = (tex_t){.magic = MAGIC('T', 'E', 'X', 0), .serial = nvn_new_serial(), .mem = g_pool + TOFF, .pool = &g_tpool, .off = TOFF};
+    g_wt.d = (nvn_texdesc){.target = NVN_TEXTURE_TARGET_2D, .format = NVN_FORMAT_RGBA8, .width = 8, .height = 8, .depth = 1, .levels = 1, .samples = 1};
+    nvn_tex_layout(&g_wt.d, &g_wt.L); if (TOFF + g_wt.L.size > (256 << 10)) abort();
+    mtl_tex_init(&g_wt); mtl_tex_cpu_written(&g_wt);
+    chain *c = &g_pcx_x;
+    ppass(c, &g_pt[0]); pdraws(c, 0); pdraws(c, 1);
+    ppass(c, &g_pt[1]); pt2t(c, &g_wt, &g_pt[1], (NVNcopyRegion){0, 0, 0, 8, 8, 1}, (NVNcopyRegion){16, 16, 0, 8, 8, 1}); pdraws(c, 2); pdraws(c, 3);
+    ppass(c, &g_pt[2]); pdraws(c, 4); pdraws(c, 5);
+    emit(c, OP_END, 0);
+    c = &g_pcx_r;
+    { uint64_t *t = emit(c, OP_RESET_COUNTER, 8); *t = NVN_COUNTER_TYPE_SAMPLES_PASSED; }
+    ppass(c, &g_pt[0]); pdraws(c, 0); pdraws(c, 1);
+    ppass(c, &g_pt[1]); pdraws(c, 2); pdraws(c, 3);
+    { uint64_t *r = emit(c, OP_REPORT_COUNTER, 16); r[0] = NVN_COUNTER_TYPE_SAMPLES_PASSED; r[1] = (uint64_t)(uintptr_t)(g_pool + ROFF2); }
+    ppass(c, &g_pt[2]); pdraws(c, 4); pdraws(c, 5); pdraws(c, 6);
+    { uint64_t *r = emit(c, OP_REPORT_COUNTER, 16); r[0] = NVN_COUNTER_TYPE_SAMPLES_PASSED; r[1] = (uint64_t)(uintptr_t)(g_pool + ROFF2); }
+    ppass(c, &g_pt[3]); { p_render_cond *rc = emit(c, OP_RENDER_COND, sizeof *rc); *rc = (p_render_cond){0, 0, (uint64_t)(uintptr_t)(g_pool + ROFF2)}; } pdraws(c, 7);
+    { p_render_cond *rc = emit(c, OP_RENDER_COND, sizeof *rc); *rc = (p_render_cond){2, 0, 0}; }
+    emit(c, OP_END, 0);
+}
+// Frame Z (workers take a clean uploaded texture read-only): T (uploaded by frame X, not written since) copied 4 times into each of targets 1..3, one worker piece each: 12 uses,
+// none waits for its turn. Frame Y (first upload on a worker): a texture Y made and filled by the CPU before the frame, used first by piece 1's copy (a worker's), nowhere before
+enum { YOFF = 0x3e000 };
+static uint8_t *g_ypool; static pool_t g_ytpool; static int g_yi;   // frame Y: a fresh storage slot each frame (a texture over bytes already uploaded would share that upload, pkg_shared)
+static tex_t g_yt; static chain g_pcz, g_pcy; static uint64_t g_zturn, g_zfast, g_zslow, g_yfirst;
+static uint8_t g_zy[2][4][64 * 64 * 4];
+static void build_zy(void) {
+    if (posix_memalign((void **)&g_ypool, (size_t)getpagesize(), 256 << 10)) abort(); memset(g_ypool, 0, 256 << 10); mtl_pool_add(g_ypool, 256 << 10); nvn_dirty_add_range(g_ypool, 256 << 10);
+    g_ytpool = (pool_t){.magic = MAGIC('P', 'O', 'O', 'L'), .flags = NVN_MEMORY_POOL_FLAGS_CPU_CACHED | NVN_MEMORY_POOL_FLAGS_GPU_CACHED, .mem = g_ypool, .size = 256 << 10};
+    chain *c = &g_pcz;
+    ppass(c, &g_pt[0]); pdraws(c, 0); pdraws(c, 1);
+    for (int k = 1; k <= 3; k++) { ppass(c, &g_pt[k]); for (int j = 0; j < 4; j++) pt2t(c, &g_wt, &g_pt[k], (NVNcopyRegion){0, 0, 0, 8, 8, 1}, (NVNcopyRegion){8 + 10 * j, 30, 0, 8, 8, 1}); pdraws(c, k); pdraws(c, k + 1); }
+    emit(c, OP_END, 0);
+    c = &g_pcy;
+    ppass(c, &g_pt[0]); pdraws(c, 2); pdraws(c, 3);
+    ppass(c, &g_pt[1]); pt2t(c, &g_yt, &g_pt[1], (NVNcopyRegion){0, 0, 0, 8, 8, 1}, (NVNcopyRegion){40, 40, 0, 8, 8, 1}); pdraws(c, 4); pdraws(c, 5);
+    ppass(c, &g_pt[2]); pdraws(c, 6); pdraws(c, 7);
+    emit(c, OP_END, 0);
+}
+static void zy_run(int on, int slot) {
+    NVNcopyRegion r = {0, 0, 0, 64, 64, 1}; uint64_t a[PCS_N], b[PCS_N];
+    setenv("DM_NVN_PAR", "0", 1); pc_init(); run_chain(&g_pcj);
+    mtl_pc_stats(a); setenv("DM_NVN_PAR", on ? "1" : "0", 1); setenv("DM_NVN_PAR_DRAWS", "40", 1); pc_init(); run_chain(&g_pcz); mtl_pc_stats(b);
+    g_zturn += b[PCS_TURNS] - a[PCS_TURNS]; g_zfast += b[PCS_TEX_FAST] - a[PCS_TEX_FAST]; g_zslow += b[PCS_TEX_SLOW] - a[PCS_TEX_SLOW];
+    for (int k = 1; k <= 3; k++) mtl_read_texels(&g_pt[k], 0, 0, &r, g_zy[slot][k - 1], 64 * 4, 64 * 64 * 4);
+    g_yt = (tex_t){.magic = MAGIC('T', 'E', 'X', 0), .serial = nvn_new_serial(), .pool = &g_ytpool}; uint64_t yo = (uint64_t)(g_yi++ % 500) * 512; g_yt.mem = g_ypool + yo; g_yt.off = (int64_t)yo;   // a new texture each frame: its first use is in this frame
+    g_yt.d = g_wt.d; nvn_tex_layout(&g_yt.d, &g_yt.L); if (g_yt.L.size > 512) abort();
+    for (uint64_t i = 0; i < g_yt.L.size; i++) g_yt.mem[i] = (uint8_t)(i * 13 + 5);
+    mtl_tex_init(&g_yt);   // not marked: its first use finds the CPU's content in its storage (tex_cpu_content)
+    setenv("DM_NVN_PAR", "0", 1); pc_init(); run_chain(&g_pcj);
+    mtl_pc_stats(a); setenv("DM_NVN_PAR", on ? "1" : "0", 1); pc_init(); run_chain(&g_pcy); mtl_pc_stats(b);
+    g_yfirst += b[PCS_W_FIRST_UP] - a[PCS_W_FIRST_UP];
+    mtl_read_texels(&g_pt[1], 0, 0, &r, g_zy[slot][3], 64 * 4, 64 * 64 * 4);
+}
+// Frame D (a worker never waits for its turn under the texture registry lock g_rmu): piece 0 (the replay thread's) draws 50 times with a texture binding that changes before every draw
+// (the argument buffer is encoded each draw, under g_rmu: no reuse); piece 1 (a worker's) draws with texture D, which the CPU filled before the frame and which nothing used before:
+// its first upload happens on the worker, inside encode_args_ under g_rmu, where it waited for piece 0 to finish, while piece 0's next draw waited for g_rmu (a freeze). A
+// watchdog ends the process after 10 s
+enum { DDRAWS = 50, TID_A = 801, TID_D = 802 };
+static tex_t g_dt; static chain g_pcd; static prog_t g_dprog; static uint8_t g_dd[2][3][64 * 64 * 4]; static _Atomic int g_dd_done;
+static void ddraws(chain *c, int base, uint64_t h0, uint64_t h1) {
+    for (int j = 0; j < DDRAWS; j++) {
+        { p_bind_handles *b = emit(c, OP_BIND_TEX, sizeof *b); b->stage = 1; b->first = 0; b->n = 1; b->h[0] = j & 1 ? h1 : h0; }   // another handle each draw: the arguments are encoded again
+        { p_scissor *s = emit(c, OP_SCISSOR, sizeof *s); *s = (p_scissor){((j + base) % 8) * 8, 40 + ((j + base) / 8 % 4) * 6, 4, 4}; }
+        { p_draw *d = emit(c, OP_DRAW, sizeof *d); *d = (p_draw){.prim = 4, .count = 3, .instances = 1}; } }
+    p_scissor *s = emit(c, OP_SCISSOR, sizeof *s); *s = (p_scissor){0, 0, 64, 64};
+}
+static void build_d(void) {
+    NvProg *pr = [NvProg new];
+    pr->sh[0] = [NvShader new]; pr->sh[0]->fn = [g_lib newFunctionWithName:@"vertex_main"]; pr->sh[0]->stage = 0; snprintf(pr->sh[0]->key, sizeof pr->sh[0]->key, "dd_v");
+    NvShader *fs = pr->sh[1] = [NvShader new]; fs->fn = fn4_note([g_lib newFunctionWithName:@"main_tex"], g_lib, @"main_tex", nil); fs->stage = 1; snprintf(fs->key, sizeof fs->key, "dd_f");
+    fs->rf.nb = 1; fs->rf.b[0] = (nvn_rbind){.kind = NVN_RB_TEX, .reg = 0, .aid = 0, .dtt = MTLTextureType2D}; fs->ae = [fs->fn newArgumentEncoderWithBufferIndex:0];
+    g_dprog = (prog_t){.magic = MAGIC('P', 'R', 'O', 'G')}; g_dprog.serial = nvn_new_serial(); serial_put(g_dprog.serial, pr);
+    mtl_reg_tex(TID_A, &g_wt, NULL);
+    chain *c = &g_pcd;
+    ppass(c, &g_pt[0]); { p_bind_program *p = emit(c, OP_BIND_PROGRAM, sizeof *p); *p = (p_bind_program){&g_dprog, 3}; } ddraws(c, 0, TID_A, TID_A | 1 << 20);
+    ppass(c, &g_pt[1]); { p_bind_program *p = emit(c, OP_BIND_PROGRAM, sizeof *p); *p = (p_bind_program){&g_dprog, 3}; } ddraws(c, 1, TID_D, TID_D | 1 << 20);
+    ppass(c, &g_pt[2]); pdraws(c, 3); pdraws(c, 4);
+    emit(c, OP_END, 0);
+}
+static void *dd_watch(void *a) {
+    (void)a;
+    for (int i = 0; i < 1000; i++) { usleep(10000); if (atomic_load(&g_dd_done)) return NULL; }
+    printf("t_par_xlate: frame D: deadlock (timeout)\n"); fflush(stdout); _exit(3);
+}
+static void d_run(int on, int slot) {
+    NVNcopyRegion r = {0, 0, 0, 64, 64, 1};
+    g_dt = (tex_t){.magic = MAGIC('T', 'E', 'X', 0), .serial = nvn_new_serial(), .pool = &g_ytpool}; uint64_t yo = (uint64_t)(g_yi++ % 500) * 512; g_dt.mem = g_ypool + yo; g_dt.off = (int64_t)yo;   // a new texture each frame
+    g_dt.d = g_wt.d; nvn_tex_layout(&g_dt.d, &g_dt.L); if (g_dt.L.size > 512) abort();
+    for (uint64_t i = 0; i < g_dt.L.size; i++) g_dt.mem[i] = (uint8_t)(i * 11 + 9);
+    mtl_tex_init(&g_dt); mtl_reg_tex(TID_D, &g_dt, NULL);   // not marked: its first use finds the CPU's content in its storage (tex_cpu_content)
+    setenv("DM_NVN_PAR", "0", 1); pc_init(); run_chain(&g_pcj);
+    setenv("DM_NVN_PAR", on ? "1" : "0", 1); setenv("DM_NVN_PAR_DRAWS", "40", 1); pc_init();
+    pthread_t w; atomic_store(&g_dd_done, 0); pthread_create(&w, NULL, dd_watch, NULL);
