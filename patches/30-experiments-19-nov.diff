+static int acs_before(int c, int rd) {   // the records [c]: a wait for the dispatch stage inside the first draw pass, before its draw rd
+    int i = 0, nd = 0; while (i < g_lopn[c] && (int)(g_lops[c][i] >> 24) != RO_RE_BEGIN) i++;
+    for (i++; i < g_lopn[c] && (int)(g_lops[c][i] >> 24) != RO_END && (int)(g_lops[c][i] >> 24) != RO_RE_BEGIN; i++) {
+        if (g_lacs[c][i]) return nd <= rd;
+        if ((int)(g_lops[c][i] >> 24) == RO_R_DRAW) nd++; }
+    return 0;
+}
