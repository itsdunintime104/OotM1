+}
+// Frame M: planned cuts where state is open. Target 3: cleared, 50 draws, then the same targets set again: a planned cut, where the pass would be continued (rtc_on) and is ended
+// instead; 50 more draws with no state set after the cut (they draw with what the next piece began from). Then a list called twice sets target 4 and clears it (its record comes twice,
+// so no cut is planned there; the clears wait, lc_push), and target 5's change is a planned cut with the clears waiting (lc_land). 25 draws into target 5, again with no state set
+static chain g_pcm, g_pcl;
+static const float g_mcol[2][4] = {{.25f, .75f, .5f, 1}, {.5f, 0, .75f, 1}};   // target 3's clear, target 4's
+static void build_open(void) {
+    chain *l = &g_pcl;
+    { p_set_rt *r = emit(l, OP_SET_RT, sizeof *r); r->n = 1; r->color[0] = &g_pt[4]; }
+    { p_clear_color *cl = emit(l, OP_CLEAR_COLOR, sizeof *cl); *cl = (p_clear_color){0, 0xf, {g_mcol[1][0], g_mcol[1][1], g_mcol[1][2], g_mcol[1][3]}}; }
+    emit(l, OP_END, 0);
+    chain *c = &g_pcm;
+    ppass(c, &g_pt[3]); { p_clear_color *cl = emit(c, OP_CLEAR_COLOR, sizeof *cl); *cl = (p_clear_color){0, 0xf, {g_mcol[0][0], g_mcol[0][1], g_mcol[0][2], g_mcol[0][3]}}; }
+    pdraws(c, 0); pdraws(c, 1);
+    { p_set_rt *r = emit(c, OP_SET_RT, sizeof *r); r->n = 1; r->color[0] = &g_pt[3]; }
+    pdraws(c, 2); pdraws(c, 3);
+    for (int i = 0; i < 2; i++) { uint64_t t = (uint64_t)(uintptr_t)l->p; memcpy(emit(c, OP_CALL, 8), &t, 8); }
+    { p_set_rt *r = emit(c, OP_SET_RT, sizeof *r); r->n = 1; r->color[0] = &g_pt[5]; }
+    pdraws(c, 4);
+    emit(c, OP_END, 0);
+}
+static uint8_t g_mx[2][NPT][64 * 64 * 4];
+static void open_test(void) {
+    build_open();
+    uint64_t s1[PCS_N], s2[PCS_N]; NVNcopyRegion r = {0, 0, 0, 64, 64, 1};
+    for (int on = 0; on < 2; on++) {
+        mtl_pc_stats(s1);
+        for (int i = 0; i < 2; i++) {
+            setenv("DM_NVN_PAR", "0", 1); pc_init(); run_chain(&g_pcj);
+            setenv("DM_NVN_PAR", on ? "1" : "0", 1); setenv("DM_NVN_PAR_DRAWS", "40", 1); pc_init(); run_chain(&g_pcm); }
+        for (int k = 0; k < NPT; k++) mtl_read_texels(&g_pt[k], 0, 0, &r, g_mx[on][k], 64 * 4, 64 * 64 * 4);
+        mtl_pc_stats(s2);
+        if (!on) { CHECK(s2[PCS_PIECES] == s1[PCS_PIECES]); continue; }
+        printf("t_par_xlate: open state: %llu pieces ended in 2 frames; cuts that ended a continued pass %llu, landed waiting clears %llu\n", (unsigned long long)(s2[PCS_PIECES] - s1[PCS_PIECES]),
+               (unsigned long long)(s2[PCS_MERGE_ENDED] - s1[PCS_MERGE_ENDED]), (unsigned long long)(s2[PCS_LC] - s1[PCS_LC]));
+        CHECK(s2[PCS_PIECES] - s1[PCS_PIECES] == 4); CHECK(s2[PCS_MERGE_ENDED] - s1[PCS_MERGE_ENDED] == 2); CHECK(s2[PCS_LC] - s1[PCS_LC] == 2);
+        planned_all_taken(s1, s2, "open state");
