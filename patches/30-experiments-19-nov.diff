+    for (int ch = 0; ch < 4; ch++) { CHECK(abs((int)p[ch] - (int)(g_mcol[0][ch] * 255 + .5f)) <= 2); CHECK(abs((int)q[ch] - (int)(g_mcol[1][ch] * 255 + .5f)) <= 2); }
+    p = g_mx[0][3] + (59 * 64 + 17) * 4; CHECK(p[0] <= 2 && p[1] >= 253 && p[2] <= 2);   // drawn only after the cut (pdraws index 26: x 16.., y 58..): green
+    for (int k = 3; k < NPT; k++) {
+        int bad = 0, first = -1; for (int i = 0; i < 64 * 64 * 4; i++) if (g_mx[0][k][i] != g_mx[1][k][i]) { if (first < 0) first = i; bad++; }
+        CHECK(bad == 0); if (bad) fprintf(stderr, "  open state: target %d: %d bytes differ with pieces on, first at pixel (%d,%d): %u vs %u\n", k, bad, first / 4 % 64, first / 4 / 64, g_mx[0][k][first], g_mx[1][k][first]); }
+}
+static void verify_walk(void) {   // DM_NVN_PAR_VERIFY=1 (P3b): the state walk's snapshot matched the live state at every piece cut; the fields that differed are named
+    if (!pcw_on()) return;
+    uint64_t v[PCW_NSTAT], fd[PCW_NF]; mtl_pcw_stats(v, fd); char line[1024]; mtl_pcw_line(0, 2, line, sizeof line); printf("t_par_xlate: %s\n", line);
+    CHECK(v[PCW_CHECKED] >= 6); CHECK(v[PCW_DIFF] == 0); CHECK(v[PCW_NOKEY] == 0); CHECK(v[PCW_ABORT] == 0);
