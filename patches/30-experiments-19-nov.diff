+// Parallel translation measurement (pure C): the best split of translation pieces, and the split when worker threads take only the submissions already waiting in the queue
+// when the replay thread picks the first of them (a batch). Unit test tests/t_par_batch.c
+#pragma once
+#include <stdint.h>
+
+static uint64_t par_best(const uint64_t *seg, int n, int k) {   // smallest possible longest chunk when n pieces in order are grouped into at most k chunks
+    uint64_t lo = 0, hi = 0; for (int i = 0; i < n; i++) { if (seg[i] > lo) lo = seg[i]; hi += seg[i]; }
+    while (lo < hi) { uint64_t mid = lo + (hi - lo) / 2, cur = 0; int used = 1;
+        for (int i = 0; i < n; i++) { if (cur + seg[i] > mid) { used++; cur = 0; } cur += seg[i]; }
+        if (used <= k) hi = mid; else lo = mid + 1; }
+    return lo; }
+// Sum over the maximal runs of equal batch ids of the best split of the run's pieces on k cores: a batch is the most one set of workers can share
+static uint64_t parb_split(const uint64_t *seg, const uint32_t *batch, int n, int k) {
+    uint64_t sum = 0; int i = 0;
+    while (i < n) { int e = i; while (e < n && batch[e] == batch[i]) e++; sum += par_best(seg + i, e - i, k); i = e; }
+    return sum; }
+// The same, but cut only at submission edges: within a batch the pieces of one submission (equal consecutive sub ids) are added up first
+static uint64_t parb_split_sub(const uint64_t *seg, const uint32_t *batch, const uint32_t *sub, int n, int k) {
+    uint64_t sum = 0; int i = 0;
+    while (i < n) { int e = i; while (e < n && batch[e] == batch[i]) e++;
