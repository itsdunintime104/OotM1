+        { p_draw *d = emit(c, OP_DRAW, sizeof *d); *d = (p_draw){.prim = 4, .count = 3, .instances = 1}; } }
+    p_scissor *s = emit(c, OP_SCISSOR, sizeof *s); *s = (p_scissor){0, 0, 64, 64};
