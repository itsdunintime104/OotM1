+    CHECK(pc_hold() ? nc >= 4 : nc == 0);   // held pieces ride the next commit (sub_cut's copy commit, mtl_sub_commit); otherwise each piece is committed when it ends
+    planned_all_taken(s1, s2, "pieces");
+    for (int k = 0; k < NPT; k++) {   // the result itself (pieces off): the clear, the copied block, the target before's (10,10) in the right half (its block, or its clear for target 0, copied last)
+        const uint8_t *p = g_px[0][k] + (2 * 64 + 2) * 4;
+        for (int ch = 0; ch < 4; ch++) CHECK(abs((int)p[ch] - (int)(g_pcol[pcol2(k)][ch] * 255 + .5f)) <= 2);
+        p = g_px[0][k] + (10 * 64 + 10) * 4; const uint8_t *w = psrc(k) + (2 * 16 + 2) * 4; CHECK(!memcmp(p, w, 4));
