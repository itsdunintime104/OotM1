+    build(&g_t[0], 0); build_pieces(); build_xr(); build_d(); build_t(); build_mb(); g_rec_probe = l_probe;
+    int nfr = 300, reps = 3; { const char *e = getenv("DM_MB_FRAMES"); if (e && atoi(e) > 1) nfr = atoi(e); } { const char *e = getenv("DM_MB_REPS"); if (e && atoi(e) > 0) reps = atoi(e) > 8 ? 8 : atoi(e); }
+    int nv = (int)(sizeof g_mbv / sizeof g_mbv[0]);
+    _Static_assert(sizeof g_mbv / sizeof g_mbv[0] <= MB_NV_MAX, "a variant past the table");
+    printf("t_par_xlate: bench: frame M, %d submissions, %d draws a frame; %d warm-up and %d timed frames per variant, the table %d times\n", MB_NSUB, g_mb_draws, MB_WARM, nfr, reps);
+    for (int rep = 0; rep < reps; rep++) for (int v = 0; v < nv; v++) mb_run(&g_mbv[v], v, rep, nfr);
+    if (ws_on()) { stg_report(0, 1); mb_run(&g_mbv[0], 0, 0, 30); stg_report(30, 30); }   // DM_NVN_WAITS=1: the [stages] line over a short run of today's variant
+    printf("t_par_xlate: bench table, submitting thread p50 ms a frame (each run; spread = max - min) | a frame alone, first submission to GPU done, p50 ms:\n");
+    for (int v = 0; v < nv; v++) { double lo = 1e9, hi = 0, sum = 0; char b[128]; int bl = 0;
+        for (int r = 0; r < reps; r++) { double x = g_mbp50[v][r]; lo = x < lo ? x : lo; hi = x > hi ? x : hi; sum += x; bl += snprintf(b + bl, sizeof b - (size_t)bl, " %.2f", x); }
+        double llo = 1e9, lhi = 0, lsum = 0; char lb[128]; int ll = 0;
+        for (int r = 0; r < reps; r++) { double x = g_mblat[v][r]; llo = x < llo ? x : llo; lhi = x > lhi ? x : lhi; lsum += x; ll += snprintf(lb + ll, sizeof lb - (size_t)ll, " %.2f", x); }
+        printf("t_par_xlate: bench %-18s%s  mean %.2f spread %.2f | alone to GPU done%s  mean %.2f spread %.2f\n", g_mbv[v].name, b, sum / reps, hi - lo, lb, lsum / reps, lhi - llo); }
+}
+int main(int argc, char **argv) { @autoreleasepool {
+    if (argc != 2) { fprintf(stderr, "usage: %s one|serial|parallel|exec|pieces\n", argv[0]); return 2; }
+    if (!strcmp(argv[1], "bench")) setenv("DM_NVN_ENC_THREAD", "1", 1);
+    if (!strcmp(argv[1], "workers")) { setenv("DM_NVN_ENC_THREAD", "1", 0); setenv("DM_UPSCALER", "metalfx", 1); setenv("DM_NVN_ASYNC_CS", "1", 1); }   // async compute on, as the owner plays (frames N1 and N2 need it)   // frames P and N: the upscaler rule (up_mfx_on)   // frame L (P4) runs through the encode thread
+    int one = !strcmp(argv[1], "one"), serial = !strcmp(argv[1], "serial"), par = !strcmp(argv[1], "parallel"), pieces = !strcmp(argv[1], "pieces");
+    g_exec = !strcmp(argv[1], "exec");
+    if (!one && !serial && !par && !g_exec && !pieces && strcmp(argv[1], "workers") && strcmp(argv[1], "bench")) { fprintf(stderr, "usage: %s one|serial|parallel|exec|pieces\n", argv[0]); return 2; }
+    crash_install();
+    { const char *e = getenv("DM_PAR_NITER"); if (e && atoi(e) > 0) NITER = atoi(e); }
+    mtl_init();
+    size_t psz = 256 << 10; if (posix_memalign((void **)&g_pool, (size_t)getpagesize(), psz)) return 2;
+    memset(g_pool, 0, psz); mtl_pool_add(g_pool, psz); nvn_dirty_add_range(g_pool, psz);
+    NSError *error = nil; g_lib = [g_dev newLibraryWithSource:@(g_msl) options:nil error:&error];
+    if (!g_lib) { fprintf(stderr, "%s\n", error.localizedDescription.UTF8String); return 2; }
+    if (!strcmp(argv[1], "workers")) { workers_test(); printf("t_par_xlate: %s: %d checks, %d failed\n", argv[1], checks, failed); return failed != 0; }
+    if (!strcmp(argv[1], "bench")) { bench_test(); printf("t_par_xlate: %s: %d checks, %d failed\n", argv[1], checks, failed); return failed != 0; }
+    if (pieces) { priv_test(); pieces_test(); printf("t_par_xlate: %s: %d checks, %d failed\n", argv[1], checks, failed); return failed != 0; }
+    int n = one ? 1 : NTHREADS;
+    for (int i = 0; i < n; i++) build(&g_t[i], i);
+    if (one) { g_go = 1; thread_main(&g_t[0]); }
+    else {
+        pthread_t th[NTHREADS];
+        if (serial) { g_go = 1; for (int i = 0; i < n; i++) { pthread_create(&th[i], NULL, thread_main, &g_t[i]); pthread_join(th[i], NULL); } }
+        else { for (int i = 0; i < n; i++) pthread_create(&th[i], NULL, thread_main, &g_t[i]); __atomic_store_n(&g_go, 1, __ATOMIC_RELEASE); for (int i = 0; i < n; i++) pthread_join(th[i], NULL); }
+    }
+    printf("t_par_xlate: %s: %d checks, %d failed\n", argv[1], checks, failed);
+    return failed != 0;
+} }
