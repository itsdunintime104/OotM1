+static void pn_check(const char *f, int k, int it, int nfb) {   // no mid-pass cut dropped for the upscaler reason; N: the chain's piece alone is the replay thread's, its values at the end
+    CHECK(g_lfbup == 0); CHECK(g_ltaken == 2); if (k > 0) CHECK(g_lfb == nfb); if (nfb) CHECK(g_lupc == 0);
