index 00000000..7924b3b8
--- /dev/null
+++ b/dm/gfx/nvn/nvn_accum.inc
@@ -0,0 +1,137 @@
+// ---------- The submission's collected lists per piece (DM_NVN_PAR, parallel translation P3c slice C2: one thread) ----------
+// Included once at the end of nvn_mtl.m. A piece collects its own ACCUM lists: at a piece end (pc_end, after the piece's commit) pca_end moves them
+// into a record of that piece and pca_begin starts the next piece with them empty; mtl_sub_commit's first step (pca_join) joins the records and the last piece's live lists in
+// piece order, so gw_commit, rc_commit, the post ring, the commit blocks, gmem_commit_patch and treg_finish_submission read what one piece would have collected. On one thread
+// the records are this thread's; in P3c a worker hands its piece's record back. Pieces off (DM_NVN_PAR=0): none of these run.
+//
+// The lists and their join (a set is joined as a union, a list is concatenated in piece order), from how their readers use them:
+//   list                                    join          readers after the join
+//   g_post / g_npost (post-commit ops)      list          post_run at the fence, in order: events and counter reports to one address (the last wins), samples passed (VIS_*) as a
+//                                                         running total. A piece's leftover visibility slots are folded at its end (VIS_FOLD, as mtl_sub_commit folds a
+//                                                         submission's), so a report or reset in a later piece adds or drops them in the same order: the total is the same
+//   g_vs / g_nvs (visibility slots)         (folded)      empty at every piece end (above); only the last piece's reach mtl_sub_commit, which folds them
+//   pend: g_pend_lo/hi/kind, g_npend        list          gw_commit (g_gw, g_gwx, um_put: a later write over the same bytes wins), pend_last / pend_since (newest entry wins)
+//   g_upd / g_nupd (inline update data)     list          pend_read, ubp_get, um_put through g_pend_upd: index + 1 into g_upd. Rebased on join: an entry's g_upd slot is
+//                                                         appended after the slots of the pieces before, and its g_pend_upd is the new index + 1
+//   g_pend_node / g_npnode, g_pend_head /   rebuilt       an index over the entries (a chain per 4 KB page bucket, newest first; entries over PEND_SPAN pages in the wide
+//   g_pend_hgen, g_pend_wide / g_nwide                    list). Not saved: rebuilt from the joined entries in order, as pend_add built it
+//   g_pend_over                             or            once over, later entries are not kept (pend_add): the join stops at the first piece that was over
+//   g_sbwp / g_nsbw (GPU write pages)       set (union)   gw_commit and sbw_hits ask "is the page written" and which kinds (src bits ORed)
+//   g_sbw_wlo / g_sbw_whi / g_nsbw_w        set (union)   gw_commit and sbw_hits: covered bytes; merged as sbw_note merges (SBW_WN full: g_sbw_over)
+//   g_sbw_over                              or            gw_commit: every page counts as written
+//   g_commit_blocks                         list          run in order at the submission's completion (gml_read of each write log, diagnostics)
+//   g_gmem_slots / g_gmem_nslots            list          gmem_commit_patch; it empties them at every commit, so a piece's are empty when it ends
+//   g_treg_transient / g_ntreg_transient    list          treg_finish_submission drops each ID's views once; order does not matter, a repeated ID is dropped once
+//   g_xv_touch / g_xv_ntouch                set (union)   xv_first_good: the first touch of (serial, level, slice) wins; 128 at most, as xv_touch_add keeps (xv is off when TBDR is
+//                                                         off, and a submission with xv active is not cut)
+// Not joined: g_gml_last (the log of the last gml_take, read at once by the same block), g_sbw_gen (a generation the same thread's shadow caches compare, cleared per piece by
+// pc_reset), g_ndrw / g_drw_* (the drain list: read only while drw_valid, false in a piece after the first, and nothing reads it at the commit), g_pend_gen (a piece bumps it to
+// empty the bucket and page tables, pend_reset). Shared, not per thread, so not here: the render-condition reports (g_rc_dirty: rc_commit) and the visibility ring slot (g_vis_ring_i).
+typedef struct { uint64_t lo, hi; uint32_t upd; uint8_t kind; } pca_pend;   // upd: index + 1 into the record's upd, 0 none
+typedef struct { uint64_t page; uint8_t src; } pca_page;
+typedef struct {
+    post_op *post; int npost, cpost;
+    pca_pend *pend; int npend, cpend; upd_ent *upd; int nupd, cupd; int pend_over;
+    pca_page *pg; int npg, cpg; uint64_t wlo[SBW_WN], whi[SBW_WN]; int nw, sbw_over;
+    gmem_slot *gm; int ngm, cgm;
+    int *treg; int ntreg, ctreg;
+    xv_touch xv[128]; int nxv;
+    __strong NSMutableArray<dispatch_block_t> *blocks;
+} pca_rec;
+static pca_rec **g_pca_xl XL_SEC;
+#define g_pca XLV(g_pca_xl)
+ static int g_pca_n_xl XL_SEC; static int g_pca_cap_xl XL_SEC;   // the records of the pieces ended in this submission, in order (kept for reuse)
+#define g_pca_n XLV(g_pca_n_xl)
+#define g_pca_cap XLV(g_pca_cap_xl)
+static void pca_room(void **p, int *cap, int need, size_t each, const char *what) {
+    if (need <= *cap) return;
+    int c = *cap ? *cap : 16; while (c < need) c *= 2;
+    *p = realloc_or_die(*p, (size_t)c * each, what); *cap = c;
+}
+// The live lists into record r (the live lists are left as they are)
+static void pca_save(pca_rec *r) {
+    pca_room((void **)&r->post, &r->cpost, g_npost, sizeof *r->post, "a piece's post-commit operations"); r->npost = g_npost; if (g_npost) memcpy(r->post, g_post, (size_t)g_npost * sizeof *g_post);
