+}
+static void pieces_test(void) {
+    build(&g_t[0], 0); build_pieces();
+    uint64_t s0[PCS_N], s1[PCS_N], s2[PCS_N]; mtl_pc_stats(s0);
+    g_pca_probe = psnap_take;   // the lists at each commit (the last one kept: the frame's)
+    g_psn_i = 0; pieces_run(0, g_px[0]);
+    mtl_pc_stats(s1); CHECK(s1[PCS_PIECES] == s0[PCS_PIECES]); CHECK(s1[PCS_PLANNED] == s0[PCS_PLANNED]);   // pieces off: none, no plan
