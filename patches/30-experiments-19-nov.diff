+// pc_end, DM_NVN_PAR_RESTORE=1: the next piece's SEED from the walk's snapshot i of the cut's record, what a P3c worker starts from. Fields the walk cannot compute (T in the table
+// at the top): g_game_barrier takes every barrier bit (the next pass begins behind the full barrier; rp_begin clears it), g_seg and the upscaler chain (g_upc_*) are carried, and
+// g_rc_skip after a counter-value condition (modes 0 / 1) is carried (counted: PCS_RC_CARRIED). The dirty flags were set by pc_reset
+enum { PC_FULL_BARRIER = 0xff };   // every NVNbarrierBits bit (nvn.h)
+static void pcw_restore(uint32_t i) {
+    if (!g_pcw_live || g_pcw_sub != g_sub_serial || i >= g_pcw_n) return;
+    const pcw_snap *z = &g_pcw[i];
+    R.rt = z->r.rt; R.has_rt = z->r.has_rt; memset(R.clear_c, 0, sizeof R.clear_c); R.clear_d = R.clear_s = 0; R.sc = z->r.sc; R.has_sc = z->r.has_sc;
+    memcpy(&S, &g_pcw_s[z->si], sizeof S);
+    if (!z->prog_one) prog_resolve();   // S.prog: the combined program's ring slot, made again from S.bst
+    g_active_queue = (queue_state *)(uintptr_t)z->aq; g_state_inited = z->inited; g_exec_seq = z->seq;
+    if (z->rc_known) g_rc_skip = z->rc_skip;
+    rcl_blk_drop();   // DM_NVN_RC_LATE: a piece starts with no pending block
+    g_ret_n = z->ret_n; for (int k = 0; k < z->ret_n; k++) g_ret[k] = z->ret[k];
+    g_vis_on = z->vis_on; g_vis_counting = z->vis_counting;
+    g_game_barrier = PC_FULL_BARRIER;
+    args_dirty_all(); g_pso_dirty = g_dss_dirty = 1;
+    pthread_mutex_lock(&g_par_mu); g_pc_stat[PCS_RESTORED]++; if (!z->rc_known) g_pc_stat[PCS_RC_CARRIED]++; pthread_mutex_unlock(&g_par_mu);
+}
