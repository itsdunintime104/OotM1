+    { p_bind_program *p = emit(c, OP_BIND_PROGRAM, sizeof *p); *p = (p_bind_program){pt, 0x20}; }
+    { p_dispatch *d = emit(c, OP_DISPATCH, sizeof *d); *d = (p_dispatch){1, 1, 1, 0, 0}; }
