diff --git a/dm/gfx/tests/t_rc_gpu.m b/dm/gfx/tests/t_rc_gpu.m
new file mode 100644
index 00000000..f940c48e
--- /dev/null
+++ b/dm/gfx/tests/t_rc_gpu.m
@@ -0,0 +1,201 @@
+// DM_NVN_RC_GPU, second part (nvn_mtl.m g_rcg): a conditional block whose counter value is a report of an earlier submission that has not completed is drawn through
+// indirect draws, and the kernel rc_eval sets their instance counts on the GPU. Run twice (check_t_rc_gpu): DM_NVN_RC_GPU=0 and =1.
+// Public NVN commands record two submissions: the queries (reset, query draw, report, four objects) and the scene (one conditional block per object: a plain and an indexed
+// draw into the object's own strip of the target). Run 1: the queries complete before the scene is translated, so the translator knows every value (the reference).
+// Run 2: a shared event on the Metal queue holds the queries, so their reports are pending while the scene is translated; then the event is signalled.
+// Objects: 0 hidden (a counted draw with no samples), 1 visible, 2 visible with three counted passes (a report of three slots: not evaluable, drawn), 3 no counted draw
+// (known 0 with the switch on). With the switch on run 2 must give the reference picture byte for byte, instance count 0 for object 0 alone and the game's count for
+// object 1; with it off run 2 draws every object. It makes a Metal device and commits GPU work
+#include "game_profile.h"
+#undef DM_GAME_RENDER_COND
+#define DM_GAME_RENDER_COND 1
+#define nvn_game_fps nvn_game_fps_mtl_default
+#include "../nvn/nvn_mtl.m"
+#undef nvn_game_fps
+#define g_ft g_ft_hle
+#include "../nvn/hle_nvn.c"
+#undef g_ft
+#define P(name) ((NVNT_##name)nvn_lookup(#name))
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failures;
+#define CHECK(c, name) do { int check_ok = !!(c); checks++; failures += !check_ok; printf("%s: %s\n", check_ok ? "PASS" : "FAIL", name); } while (0)
+static void require(int ok, const char *name) { CHECK(ok, name); if (!ok) exit(2); }
+enum { W = 8, H = 8, BYTES = W * H * 4, POOL_BYTES = 1 << 20, TEX_A = 0x80000, TEX_B = 0x90000, TEX_C = 0x98000, OUTPUT = 0xa0000, EVENT = 0xa1000, COUNTS = 0xa2000, INDEX = 0xa3000, NOBJ = 4 };
+static NVNdevice device; static NVNqueue queue; static NVNmemoryPool pool; static NVNcommandBuffer command;
+static NVNtexture target, query_target, other_target; static NVNprogram shown, hidden; static uint8_t *memory; static NVNbufferAddress output;
+static const NVNcopyRegion region = {0, 0, 0, W, H, 1};
+static const float viewport[] = {0, 0, W, H}, blue[] = {0, 0, 1, 1};
+
+static uint64_t *counts(int i) { return (uint64_t *)(memory + COUNTS) + i * 4; }   // 32 bytes apart: the report's record, then the reference the game compares it with (0)
+static int landed(NVNsync *sync, uint64_t timeout) {
+    NVNsyncWaitResult r = P(nvnSyncWait)(sync, timeout);
+    return r == NVN_SYNC_WAIT_RESULT_ALREADY_SIGNALED || r == NVN_SYNC_WAIT_RESULT_CONDITION_SATISFIED;
+}
+static void submit(NVNcommandHandle handle, NVNsync *sync) {
+    P(nvnSyncInitialize)(sync, &device); P(nvnQueueSubmitCommands)(&queue, 1, &handle);
+    P(nvnQueueFenceSync)(&queue, sync, NVN_SYNC_CONDITION_ALL_GPU_COMMANDS_COMPLETE, 0);
+}
+static void finish(NVNsync *sync) { require(landed(sync, 5000000000ull), "queue tail and GPU work complete"); P(nvnSyncFinalize)(sync); }
+static int encoded(NVNsync *sync) {   // the submission was translated and handed to the Metal queue
+    uint64_t deadline = now_ns() + 2000000000ull; int e = 0;
+    do {
+        pthread_mutex_lock(&nq_mu); sync_t *st = (sync_t *)sync;
+        e = st->fenced == 3 && ((nq_receipt *)(uintptr_t)st->fence)->published;
+        pthread_mutex_unlock(&nq_mu); if (!e) usleep(1000);
+    } while (!e && now_ns() < deadline);
+    return e;
+}
+static void init_texture(NVNtexture *texture, unsigned offset) {
+    NVNtextureBuilder tb = {0}; P(nvnTextureBuilderSetDefaults)(&tb); P(nvnTextureBuilderSetDevice)(&tb, &device);
+    P(nvnTextureBuilderSetTarget)(&tb, NVN_TEXTURE_TARGET_2D); P(nvnTextureBuilderSetSize2D)(&tb, W, H);
+    P(nvnTextureBuilderSetFormat)(&tb, NVN_FORMAT_RGBA8); P(nvnTextureBuilderSetStorage)(&tb, &pool, offset);
+    require(P(nvnTextureInitialize)(texture, &tb), "texture initialized");
+}
+static void init_program(NVNprogram *program, NvProg *compiled) {   // synthetic MSL replaces only game shader loading
+    require(P(nvnProgramInitialize)(program, &device), "program object initialized");
+    prog_t *p = (prog_t *)program; p->serial = nvn_new_serial(); serial_put(p->serial, compiled);
+}
+static void set_target(NVNtexture *texture) { const NVNtexture *colors[] = {texture}; P(nvnCommandBufferSetRenderTargets)(&command, 1, colors, NULL, NULL, NULL); }
+static void query_draw(void) { P(nvnCommandBufferDrawArrays)(&command, NVN_DRAW_PRIMITIVE_TRIANGLES, 0, 3); }
+// The queries: one reset, the object's query draws and one report each
+static NVNcommandHandle record_queries(void) {
+    P(nvnCommandBufferBeginRecording)(&command);
+    P(nvnCommandBufferSetRenderEnable)(&command, 1);
+    set_target(&query_target); P(nvnCommandBufferSetViewports)(&command, 0, 1, viewport); P(nvnCommandBufferSetScissor)(&command, 0, 0, W, H);
+    P(nvnCommandBufferClearColor)(&command, 0, blue, 15);
+    for (int i = 0; i < NOBJ; i++) {
+        P(nvnCommandBufferResetCounter)(&command, NVN_COUNTER_TYPE_SAMPLES_PASSED);
+        if (i == 0) { P(nvnCommandBufferBindProgram)(&command, &hidden, 3); query_draw(); }   // a counted draw outside the target: 0 samples
+        if (i == 1) { P(nvnCommandBufferBindProgram)(&command, &shown, 3); query_draw(); }
+        if (i == 2) { P(nvnCommandBufferBindProgram)(&command, &shown, 3); query_draw(); set_target(&other_target); query_draw(); set_target(&query_target); query_draw(); }   // three passes: three slots
+        P(nvnCommandBufferReportCounter)(&command, NVN_COUNTER_TYPE_SAMPLES_PASSED, (uintptr_t)counts(i));
+    }
+    return P(nvnCommandBufferEndRecording)(&command);
+}
+// The scene: each object is one conditional block ("draw if not equal" against 0) of a plain draw into the upper half and an indexed draw into the lower half of its strip
+static NVNcommandHandle record_scene(unsigned offset) {
+    P(nvnCommandBufferBeginRecording)(&command);
+    P(nvnCommandBufferSetRenderEnable)(&command, 1);
+    set_target(&target); P(nvnCommandBufferSetViewports)(&command, 0, 1, viewport); P(nvnCommandBufferSetScissor)(&command, 0, 0, W, H);
+    P(nvnCommandBufferClearColor)(&command, 0, blue, 15);
+    P(nvnCommandBufferBindProgram)(&command, &shown, 3);
+    for (int i = 0; i < NOBJ; i++) {
+        P(nvnCommandBufferSetRenderEnableConditional)(&command, (NVNconditionalRenderMode)1, (uintptr_t)counts(i));
+        P(nvnCommandBufferSetScissor)(&command, i * 2, 0, 2, H / 2);
+        P(nvnCommandBufferDrawArrays)(&command, NVN_DRAW_PRIMITIVE_TRIANGLES, 0, 3);
+        P(nvnCommandBufferSetScissor)(&command, i * 2, H / 2, 2, H / 2);
+        P(nvnCommandBufferDrawElements)(&command, NVN_DRAW_PRIMITIVE_TRIANGLES, NVN_INDEX_TYPE_UNSIGNED_SHORT, 3, (uintptr_t)(memory + INDEX));
+    }
+    P(nvnCommandBufferSetRenderEnable)(&command, 1);
+    P(nvnCommandBufferCopyTextureToBuffer)(&command, &target, NULL, &region, output + offset, 0);
+    return P(nvnCommandBufferEndRecording)(&command);
+}
+// Object i's strip of the picture at offset: 1 = all green (drawn), 0 = all blue (not drawn), -1 = anything else
+static int strip(unsigned offset, int i) {
+    const uint8_t green[] = {0, 255, 0, 255}, bl[] = {0, 0, 255, 255}; int g = 0, b = 0;
+    for (int y = 0; y < H; y++) for (int x = i * 2; x < i * 2 + 2; x++) { const uint8_t *px = memory + OUTPUT + offset + (y * W + x) * 4; g += !memcmp(px, green, 4); b += !memcmp(px, bl, 4); }
+    return g == 2 * H ? 1 : b == 2 * H ? 0 : -1;
+}
+typedef struct { uint64_t v[RCG_NSTAT]; uint64_t zero; } st;
+static st stats(void) { st s; mtl_rcg_stats(s.v); s.zero = mtl_rc_zero(); return s; }
+int main(void) { @autoreleasepool {
+    if (setvbuf(stdout, NULL, _IONBF, 0)) abort();
+    const char *env = getenv("DM_NVN_RC_GPU"); int on = env && atoi(env);
+    const char *envc = getenv("DM_NVN_RC_GPU_CHECK"); int chk = envc && atoi(envc);   // the self-check: every count the kernel wrote against the landed values
+    mtl_init(); NSError *error = nil;
+    id<MTLLibrary> library = [g_dev newLibraryWithSource:@"#include <metal_stdlib>\nusing namespace metal;\n"
+        "vertex float4 v(uint i [[vertex_id]]) { const float2 p[] = {float2(-1,-1),float2(3,-1),float2(-1,3)}; return float4(p[i],0.5,1); }\n"
+        "vertex float4 voff(uint i [[vertex_id]]) { const float2 p[] = {float2(5,5),float2(7,5),float2(5,7)}; return float4(p[i],0.5,1); }\n"
+        "fragment float4 green() { return float4(0,1,0,1); }\n"
+        options:nil error:&error];
+    if (!library) fprintf(stderr, "%s\n", error.localizedDescription.UTF8String);
+    require(library != nil, "synthetic shaders compile");
+    NvProg *ps = [NvProg new], *ph = [NvProg new];
+    for (int i = 0; i < 2; i++) {
+        NvShader *vs = [NvShader new]; vs->fn = [library newFunctionWithName:i ? @"voff" : @"v"];
+        NvShader *fs = [NvShader new]; fs->stage = 1; fs->rf.color_mask = 1; fs->fn = [library newFunctionWithName:@"green"];
+        (i ? ph : ps)->sh[0] = vs; (i ? ph : ps)->sh[1] = fs;
+    }
+    NVNdeviceBuilder db = {0}; P(nvnDeviceBuilderSetDefaults)(&db); require(P(nvnDeviceInitialize)(&device, &db), "device initialized");
+    NVNqueueBuilder qb = {0}; P(nvnQueueBuilderSetDefaults)(&qb); P(nvnQueueBuilderSetDevice)(&qb, &device); require(P(nvnQueueInitialize)(&queue, &qb), "queue initialized");
+    require(!posix_memalign((void **)&memory, getpagesize(), POOL_BYTES), "pool storage allocated"); memset(memory, 0, POOL_BYTES);
+    NVNmemoryPoolBuilder pb = {0}; P(nvnMemoryPoolBuilderSetDefaults)(&pb); P(nvnMemoryPoolBuilderSetDevice)(&pb, &device);
+    P(nvnMemoryPoolBuilderSetStorage)(&pb, memory, POOL_BYTES); P(nvnMemoryPoolBuilderSetFlags)(&pb, 0x24); require(P(nvnMemoryPoolInitialize)(&pool, &pb), "pool initialized");
+    NVNbufferBuilder bb = {0}; NVNbuffer buffer; P(nvnBufferBuilderSetDefaults)(&bb); P(nvnBufferBuilderSetDevice)(&bb, &device);
+    P(nvnBufferBuilderSetStorage)(&bb, &pool, OUTPUT, BYTES * 2); require(P(nvnBufferInitialize)(&buffer, &bb), "readback buffer initialized"); output = P(nvnBufferGetAddress)(&buffer);
+    require(P(nvnCommandBufferInitialize)(&command, &device), "command buffer initialized"); P(nvnCommandBufferAddCommandMemory)(&command, &pool, 0, TEX_A);
+    init_texture(&target, TEX_A); init_texture(&query_target, TEX_B); init_texture(&other_target, TEX_C);
+    init_program(&shown, ps); init_program(&hidden, ph);
+    { uint16_t ix[3] = {0, 1, 2}; memcpy(memory + INDEX, ix, sizeof ix); }
+
+    for (int run = 0; run < 2; run++) {   // 0: the reference (every value known at translation); 1: the reports pending at translation
+        unsigned offset = run ? BYTES : 0; NVNsync qs, ss;
+        for (int i = 0; i < NOBJ; i++) { counts(i)[0] = 99; counts(i)[2] = 0; }
+        id<MTLSharedEvent> gate = nil; dispatch_semaphore_t cancel = dispatch_semaphore_create(0), retired = dispatch_semaphore_create(0);
+        if (run) {
+            gate = [g_dev newSharedEvent]; if (!gate) abort();
+            [g_q4 waitForEvent:gate value:1];   // everything committed after it waits on the GPU side
+            dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+                if (dispatch_semaphore_wait(cancel, dispatch_time(DISPATCH_TIME_NOW, 6000000000ll))) gate.signaledValue = 1;   // a stuck test does not hold the queue for good
+                dispatch_semaphore_signal(retired);
+            });
+        }
+        submit(record_queries(), &qs);
+        require(encoded(&qs), run ? "queries encoded while their completion is held" : "queries encoded");
+        if (!run) finish(&qs);
+        st s0 = stats();
+        submit(record_scene(offset), &ss);
+        require(encoded(&ss), run ? "scene encoded while the queries are pending" : "scene encoded");
+        st s1 = stats();
+        const rcg_hdr *h = g_rcg_last; const uint32_t *args = h ? (const uint32_t *)((const uint8_t *)h + 32 + RCG_RECS * sizeof(rcg_rec)) : NULL;
+        if (!run) {
+            CHECK(counts(0)[0] == 0 && counts(1)[0] > 0 && counts(2)[0] > 0 && counts(3)[0] == 0, "reference: samples 0, > 0, > 0, 0");
+            CHECK(s1.v[RCG_BLOCKS] == s0.v[RCG_BLOCKS] && s1.v[RCG_EVALS] == s0.v[RCG_EVALS] && !h, "reference: known values make no pending block");
+        } else {
+            int pending = 1; for (int i = 0; i < NOBJ; i++) pending &= counts(i)[0] == 99;
+            CHECK(pending, "no report had landed when the scene was encoded");
+            const rc_report *r2 = rc_find((uintptr_t)counts(2));
+            CHECK(r2 && r2->gs_n == 255 && r2->gs_why == RCG_FB_SLOTS, "object 2: a report of three slots is not evaluable");
+            if (on) {
+                CHECK(s1.v[RCG_BLOCKS] - s0.v[RCG_BLOCKS] == 2 && s1.v[RCG_EVALS] - s0.v[RCG_EVALS] == 1 && s1.v[RCG_DRAWS] - s0.v[RCG_DRAWS] == 4, "on: two pending blocks, one evaluation point, four indirect draws");
+                CHECK(s1.v[RCG_FB_SLOTS] - s0.v[RCG_FB_SLOTS] == 1, "on: the three-slot report is counted as a fallback");
+                CHECK(s1.zero - s0.zero == 1, "on: object 3 is decided as a known 0");
+                int other = 0; for (int k = RCG_FB_RING; k < RCG_NSTAT; k++) other += s1.v[k] != s0.v[k];
+                CHECK(!other, "on: no other fallback");
+                CHECK(h && h->n == 4 && h->tg[0] == 1 && h->nvis == VIS_SLOTS, "on: the header holds four records");
+                if (h) CHECK(args[1] == 1 && args[6] == 1 && args[11] == 1 && args[16] == 1 && args[0] == 3 && args[5] == 3, "on: before the GPU ran every count is the game's");
+            } else CHECK(s1.v[RCG_BLOCKS] == s0.v[RCG_BLOCKS] && s1.v[RCG_EVALS] == s0.v[RCG_EVALS] && s1.zero == s0.zero && !h, "off: no pending block, no evaluation point");
+            gate.signaledValue = 1; dispatch_semaphore_signal(cancel);
+            require(!dispatch_semaphore_wait(retired, dispatch_time(DISPATCH_TIME_NOW, 8000000000ll)), "gate rescue retired");
+            finish(&qs);
+        }
+        finish(&ss);
+        st s2 = stats();
+        int d[NOBJ]; for (int i = 0; i < NOBJ; i++) d[i] = strip(offset, i);
+        printf("RESULT run %d (%s): strips %d %d %d %d, samples %llu %llu %llu %llu\n", run, run ? "pending" : "reference", d[0], d[1], d[2], d[3],
+               (unsigned long long)counts(0)[0], (unsigned long long)counts(1)[0], (unsigned long long)counts(2)[0], (unsigned long long)counts(3)[0]);
+        if (!run) CHECK(d[0] == 0 && d[1] == 1 && d[2] == 1 && d[3] == 0, "reference: objects 1 and 2 drawn, 0 and 3 not");
+        else {
+            CHECK(counts(0)[0] == 0 && counts(1)[0] > 0 && counts(2)[0] > 0 && counts(3)[0] == 0, "pending: the reports land with samples 0, > 0, > 0, 0");
+            if (on) {
+                CHECK(h && args[1] == 0 && args[6] == 0, "on: object 0's two draws have instance count 0");
+                CHECK(h && args[11] == 1 && args[16] == 1, "on: object 1 (samples > 0) keeps the game's count");
+                CHECK(h && h->zeroed == 2 && s2.v[RCG_ZEROED] - s0.v[RCG_ZEROED] == 2, "on: the kernel counted two draws set to 0");
+                CHECK(!memcmp(memory + OUTPUT, memory + OUTPUT + BYTES, BYTES), "on: the picture is the reference's, byte for byte");
+                if (chk) CHECK(s2.v[RCG_CHECKED] - s0.v[RCG_CHECKED] == 4 && s2.v[RCG_MISMATCH_HID] == 0 && s2.v[RCG_MISMATCH_DRAWN] == 0 && s2.v[RCG_UNCHECKED] == 0, "check on: four draws compared with the landed values, no mismatch");
+                else CHECK(s2.v[RCG_CHECKED] == 0 && s2.v[RCG_UNCHECKED] == 0, "check off: nothing compared");
+                CHECK(d[0] == 0 && d[1] == 1 && d[2] == 1 && d[3] == 0, "on: objects 1 and 2 drawn, 0 and 3 not");
+            } else CHECK(d[0] == 1 && d[1] == 1 && d[2] == 1 && d[3] == 1, "off: every object is drawn while its value is pending");
+        }
+    }
+    P(nvnQueueFinish)(&queue);
+    P(nvnProgramFinalize)(&shown); P(nvnProgramFinalize)(&hidden);
+    P(nvnTextureFinalize)(&target); P(nvnTextureFinalize)(&query_target); P(nvnTextureFinalize)(&other_target); P(nvnCommandBufferFinalize)(&command);
+    P(nvnBufferFinalize)(&buffer); P(nvnMemoryPoolFinalize)(&pool);
+    P(nvnQueueFinalize)(&queue); P(nvnDeviceFinalize)(&device); free(memory);
+    printf("t_rc_gpu: DM_NVN_RC_GPU=%d DM_NVN_RC_GPU_CHECK=%d: %d checks, %d failed\n", on, chk, checks, failures); return failures != 0;
+} }
diff --git a/dm/gfx/tests/t_rc_late.m b/dm/gfx/tests/t_rc_late.m
new file mode 100644
index 00000000..613c685a
--- /dev/null
+++ b/dm/gfx/tests/t_rc_late.m
@@ -0,0 +1,164 @@
+// DM_NVN_RC_LATE (nvn_mtl.m g_rcl_t): a conditional block whose counter value is not back at translation, inside a pre-encode hold, is encoded as indirect t_draws, and the
+// t_draws get instance count 0 when the game opens the gate and the condition is false by then. Run twice (check_t_rc_late): DM_NVN_RC_LATE=0 and =1.
+// DM_NVN_RC_LAST (0 / 1, t_last at the end): a pending report reads as the last landed value of its address; the completion handler's rc_landed call is made here directly.
+// Real here: the report table (rc_note, rc_commit, rc_value), OP_RENDER_COND through mtl_exec, the draw wrappers (enc_r_draw, enc_r_draw_instanced, enc_r_draw_indexed),
+// the t_frame arena, mtl_hold_release and hold_force. Stood in for: the encoder (a stub that notes each Metal draw call), the hold (g_hold_open set directly: no encode
+// thread, no kept commits), and the lines of OP_DRAW / OP_DRAW_IDX and draw_ that set g_rcl_t.in (copied in t_draws()). Nothing is committed to the GPU
+#include "game_profile.h"
+#undef DM_GAME_RENDER_COND
+#define DM_GAME_RENDER_COND 1
+#define nvn_game_fps nvn_game_fps_mtl_default
+#include "../nvn/nvn_mtl.m"
+#undef nvn_game_fps
+#define g_ft g_ft_hle
+#include "../nvn/hle_nvn.c"
+#undef g_ft
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(c) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL line %d (%s): %s\n", __LINE__, t_case, #c); } } while (0)
+static const char *t_case = "";
+
+@interface StubEnc : NSObject { @public int plain, inst, idx, ind, idx_ind, n; uint64_t gpu[16]; } @end
+@implementation StubEnc
+- (void)drawPrimitives:(MTLPrimitiveType)p vertexStart:(NSUInteger)v vertexCount:(NSUInteger)c { plain++; }
+- (void)drawPrimitives:(MTLPrimitiveType)p vertexStart:(NSUInteger)v vertexCount:(NSUInteger)c instanceCount:(NSUInteger)i baseInstance:(NSUInteger)b { inst++; }
+- (void)drawPrimitives:(MTLPrimitiveType)p indirectBuffer:(uint64_t)g { ind++; if (n < 16) gpu[n++] = g; }
+- (void)drawIndexedPrimitives:(MTLPrimitiveType)p indexCount:(NSUInteger)c indexType:(MTLIndexType)t indexBuffer:(uint64_t)g indexBufferLength:(NSUInteger)l instanceCount:(NSUInteger)i baseVertex:(NSInteger)bv baseInstance:(NSUInteger)bi { idx++; }
+- (void)drawIndexedPrimitives:(MTLPrimitiveType)p indexType:(MTLIndexType)t indexBuffer:(uint64_t)g indexBufferLength:(NSUInteger)l indirectBuffer:(uint64_t)a { idx_ind++; if (n < 16) gpu[n++] = a; }
+@end
+
+static uint64_t t_slots[4] __attribute__((aligned(16)));   // two 16-byte report records: the query's samples, and the reference the game compares it with (0)
+static StubEnc *t_enc;
+static uint64_t t_fence = 100, t_hold;
+static int t_gpu;   // DM_NVN_RC_GPU: the hold path is off, so a pending block inside a hold is drawn directly
+static void t_cond(int mode) {   // SetRenderEnableConditional (0 / 1) or SetRenderEnable (2 / 3), through the translator
+    struct { op_hdr h; p_render_cond c; op_hdr e; } s = {{OP_RENDER_COND, 8 + sizeof(p_render_cond)}, {mode, 0, (uintptr_t)t_slots}, {OP_END, 8}};
+    mtl_exec((const uint8_t *)&s);
+}
+// A plain, an instanced and an indexed draw as OP_DRAW / OP_DRAW_IDX and draw_ make them (the g_rcl_t.in lines are copies of theirs)
+static void t_draws(void) {
+    for (int k = 0; k < 3; k++) {
+        rcl_draw_begin(&k);
+        if (g_rcl_t.in && g_rcl_t.rec == (const void *)&k && !g_defer_replaying) g_rcl_t.in = 2;
+        if (k == 0) enc_r_draw((id)t_enc, MTLPrimitiveTypeTriangle, 9, 3);
+        if (k == 1) enc_r_draw_instanced((id)t_enc, MTLPrimitiveTypeTriangle, 0, 3, 4, 1);
+        if (k == 2) enc_r_draw_indexed((id)t_enc, MTLPrimitiveTypeTriangle, 6, MTLIndexTypeUInt16, 0x1000, 12, 2, -5, 7);
+        if (g_rcl_t.in) rcl_draw_end();
+    }
+}
+static const uint32_t *t_args(int k) { return (const uint32_t *)(g_cur_arena->cpu + (t_enc->gpu[k] - g_cur_arena->gpu)); }
+typedef struct { uint64_t b, z, d, o; } st4;
+static st4 t_stats(void) { st4 s; mtl_rcl_stats(&s.b, &s.z, &s.d, &s.o); return s; }
+typedef struct { uint64_t v[5]; } st5;   // forced, not back, visible, releases with a block, decided with the last landed value
+static st5 t_why(void) { st5 s; mtl_rcl_why(s.v); return s; }
+enum { LAND_NONE, LAND_FALSE, LAND_TRUE };
+enum { REL_GATE, REL_FORCED, REL_OLDER_FIRST };   // the game opens the gate; the hold is ended by force; a release of an older hold comes first
+// One t_frame: the query's report pending on a fence, [a hold open], the condition, three t_draws, [the report written again], [the value lands], the release.
+// on: the switch. Returns nothing; the checks say what each case must give
+static void t_frame(const char *name, int on, int hold, int land, int rel, int rewrite) {
+    t_case = name;
+    uint64_t f = ++t_fence, a = (uintptr_t)t_slots, x = 0, h = 0; st4 s0 = t_stats(); st5 w0_ = t_why();
+    t_slots[0] = 99; t_slots[2] = 0; rc_note(a, 2); rc_commit(f);
+    CHECK(!rc_value(a, &x));   // not back (and no report of the slot has landed through rc_landed: the same with DM_NVN_RC_LAST)
+    if (hold) { h = (t_hold += 2); atomic_store(&g_hold_first, f + 1); atomic_store(&g_hold_open, h); }
+    t_enc = [StubEnc new];
+    t_cond(1);   // draw if not equal: hidden when the samples equal the reference
+    CHECK(!g_rc_skip);
+    int late = on && hold && !t_gpu;
+    CHECK((g_rcl_t.blk != 0) == late);
+    t_draws();
+    if (!late) { CHECK(t_enc->plain == 1 && t_enc->inst == 1 && t_enc->idx == 1 && t_enc->ind == 0 && t_enc->idx_ind == 0); }   // (a), (e): direct t_draws as today
+    else {
+        CHECK(t_enc->plain == 0 && t_enc->inst == 0 && t_enc->idx == 0 && t_enc->ind == 2 && t_enc->idx_ind == 1 && t_enc->n == 3);
+        const uint32_t w0[4] = {3, 1, 9, 0}, w1[4] = {3, 4, 0, 1}, w2[5] = {6, 2, 0, (uint32_t)-5, 7};
+        CHECK(!memcmp(t_args(0), w0, sizeof w0)); CHECK(!memcmp(t_args(1), w1, sizeof w1)); CHECK(!memcmp(t_args(2), w2, sizeof w2));
+        int other = 0; rcl_draw_begin(&other); g_rcl_t.in = 2; enc_r_draw_indirect((id)t_enc, MTLPrimitiveTypeTriangle, 0x2000); rcl_draw_end();   // a kind not covered (the game's own indirect draw): as before, counted
+        CHECK(t_enc->ind == 3);
+        int outer = 0, inner = 0; rcl_draw_begin(&outer);   // a draw made inside a draw of the block (another record: a deferred or synthetic one) stays direct
+        if (g_rcl_t.in && g_rcl_t.rec == (const void *)&inner && !g_defer_replaying) g_rcl_t.in = 2;
+        enc_r_draw((id)t_enc, MTLPrimitiveTypeTriangle, 0, 3); CHECK(t_enc->plain == 1 && g_rcl_t.in == 1); rcl_draw_end();
+    }
+    if (rewrite) rc_note(a, 2);   // a later report to the same slot in the held t_frame: the value the condition asked for can no longer be told from the table
+    if (land) { t_slots[0] = land == LAND_FALSE ? 0 : 5; atomic_store(&g_rc_complete, f); }
+    if (hold) {
+        if (rel == REL_OLDER_FIRST) { mtl_hold_release(h - 1); CHECK(atomic_load(&g_hold_open) == h); if (late) CHECK(t_args(0)[1] == 1 && t_args(1)[1] == 4 && t_args(2)[1] == 2); }
+        if (rel == REL_FORCED) hold_force("test"); else mtl_hold_release(h);
+        CHECK(!atomic_load(&g_hold_open));
+    }
+    st4 s1 = t_stats();
+    int zero = late && land == LAND_FALSE && rel != REL_FORCED && !rewrite;
+    if (late) {
+        if (zero) CHECK(t_args(0)[1] == 0 && t_args(1)[1] == 0 && t_args(2)[1] == 0);   // (b)
+        else CHECK(t_args(0)[1] == 1 && t_args(1)[1] == 4 && t_args(2)[1] == 2);       // (c), (d)
+        CHECK(t_args(0)[0] == 3 && t_args(1)[0] == 3 && t_args(2)[0] == 6);             // only the instance count changes
+    }
+    CHECK(s1.b - s0.b == (uint64_t)late); CHECK(s1.z - s0.z == (uint64_t)zero); CHECK(s1.d - s0.d == (zero ? 3u : 0u)); CHECK(s1.o - s0.o == 2 * (uint64_t)late);
+    st5 w1_ = t_why(); int forced = late && rel == REL_FORCED, notback = late && !forced && (land == LAND_NONE || rewrite), visible = late && !forced && !notback && !zero;   // one reason for each released block
+    CHECK(w1_.v[0] - w0_.v[0] == (uint64_t)forced); CHECK(w1_.v[1] - w0_.v[1] == (uint64_t)notback); CHECK(w1_.v[2] - w0_.v[2] == (uint64_t)visible); CHECK(w1_.v[3] - w0_.v[3] == (uint64_t)late); CHECK(w1_.v[4] == w0_.v[4]);
+    if (late) CHECK(t_enc->plain == 1);
+    int d0 = t_enc->plain + t_enc->inst + t_enc->idx, i0 = t_enc->ind + t_enc->idx_ind;
+    t_draws();   // after the release the block takes no more t_draws
+    CHECK(t_enc->plain + t_enc->inst + t_enc->idx == d0 + 3 && t_enc->ind + t_enc->idx_ind == i0);
+    t_cond(2);
+    CHECK(!g_rcl_t.blk);
+    if (rewrite) rc_commit(++t_fence);
+    atomic_store(&g_rc_complete, t_fence);   // everything lands before the next case
+}
+// DM_NVN_RC_LAST. last: the switch. A report of the slot pending on a fence, the condition, then the report completes with value land (rc_landed stands in for post_run).
+// decided: the condition must be decided with the last landed value, which must be want
+static void t_last_frame(const char *name, int decided, uint64_t want, uint64_t land) {
+    t_case = name;
+    uint64_t f = ++t_fence, a = (uintptr_t)t_slots, x = 77; int l = 0; st5 w0_ = t_why(); st4 s0 = t_stats();
+    rc_note(a, 2); rc_commit(f);
+    int k = rc_value_l(a, &x, &l);
+    CHECK(k == decided && l == decided); if (decided) CHECK(x == want);
+    t_cond(1);   // draw if not equal: hidden when the samples equal the reference (0)
+    CHECK(g_rc_skip == (decided && want == 0)); CHECK(!g_rcl_t.blk);
+    st5 w1_ = t_why(); st4 s1 = t_stats();
+    CHECK(w1_.v[4] - w0_.v[4] == (uint64_t)decided); CHECK(s1.b == s0.b);
+    t_cond(2);
+    t_slots[0] = land; rc_landed(a); atomic_store(&g_rc_complete, f);   // the completion: the value, the flag, then the fence
+    x = 77; l = 0; CHECK(rc_value_l(a, &x, &l) && x == land && !l);   // a landed report is read as before
+}
+static void t_last(int last) {
+    uint64_t a = (uintptr_t)t_slots, x = 0; int l = 0;
+    t_slots[0] = 0; t_slots[2] = 0;   // the slot holds 0 (false), but no report of it has landed through the completion handler
+    t_last_frame("last: no earlier landed value", 0, 0, 0);                    // unknown, drawn; lands 0
+    t_last_frame("last: earlier value 0", last, 0, 5);                         // on: not drawn; off: unknown, drawn; lands 5
+    t_last_frame("last: earlier value 5", last, 5, 0);                         // on: drawn as known; lands 0: the newer report replaced the value
+    t_last_frame("last: earlier value 0 again", last, 0, 0);
+    t_case = "last: report not committed"; rc_note(a, 2); CHECK(!rc_value_l(a, &x, &l) && !l); rc_commit(++t_fence);   // dirty with no value: unknown
+    t_cond(1); CHECK(g_rc_skip == last); t_cond(2);                            // committed: decided from the 0 that landed
+    t_case = "last: explicit write after the report"; uint64_t w = 3; rc_write(a, 8, &w, 0);   // a later buffer write is the newest writer: its bytes are known, not the landed ones
+    x = 77; l = 0; CHECK(rc_value_l(a, &x, &l) && x == 3 && !l); rc_commit(++t_fence);
+    rc_note(a, 2); rc_commit(++t_fence);                                       // and the next report of the slot has no landed report value before it
+    CHECK(!rc_value_l(a, &x, &l) && !l); t_cond(1); CHECK(!g_rc_skip); t_cond(2);
+    t_case = "last: unimplemented counter kind"; rc_landed(a); rc_note(a, 3); rc_commit(++t_fence); CHECK(!rc_value_l(a, &x, &l) && !l);   // conservative stays unknown
+    atomic_store(&g_rc_complete, t_fence);
+}
+int main(void) { @autoreleasepool {
+    const char *e = getenv("DM_NVN_RC_LATE"); int on = e && atoi(e);
+    const char *e2 = getenv("DM_NVN_RC_LAST"); int last = e2 && atoi(e2);
+    const char *e3 = getenv("DM_NVN_RC_GPU"); t_gpu = e3 && atoi(e3);
+    mtl_init(); arena_begin();
+    g_sub_thread = pthread_self(); atomic_store(&g_sub_thread_set, 1);   // the translating thread is the replay thread
+    t_frame("no hold, value lands false", on, 0, LAND_FALSE, REL_GATE, 0);              // (e)
+    t_frame("hold, value lands false before the gate opens", on, 1, LAND_FALSE, REL_GATE, 0);   // (a) off, (b) on
+    t_frame("hold, value lands true", on, 1, LAND_TRUE, REL_GATE, 0);                    // (c)
+    t_frame("hold, value still not back at the gate", on, 1, LAND_NONE, REL_GATE, 0);    // (d)
+    t_frame("hold ended by force, value false", on, 1, LAND_FALSE, REL_FORCED, 0);       // (d)
+    t_frame("hold, slot reported again before the gate", on, 1, LAND_FALSE, REL_GATE, 1);
+    t_frame("hold, an older hold's release first", on, 1, LAND_FALSE, REL_OLDER_FIRST, 0);
+    // A condition known at translation stays the translator's: false drops the t_draws, no pending block
+    t_case = "known false"; t_slots[0] = 0; t_slots[2] = 0; atomic_store(&g_hold_open, t_hold += 2); t_cond(1); CHECK(g_rc_skip && !g_rcl_t.blk); mtl_hold_release(t_hold); t_cond(2);
+    // A pending block ends when the thread takes its state from elsewhere
+    if (on && !t_gpu) { t_case = "state reset"; uint64_t f = ++t_fence; rc_note((uintptr_t)t_slots, 2); rc_commit(f); atomic_store(&g_hold_open, t_hold += 2); t_cond(1); CHECK(g_rcl_t.blk); state_reset(); CHECK(!g_rcl_t.blk);
+        mtl_hold_release(t_hold); atomic_store(&g_rc_complete, f); }
+    t_last(last);
+    printf("t_rc_late: DM_NVN_RC_LATE=%d DM_NVN_RC_LAST=%d: %d checks, %d failed\n", on, last, checks, failed);
+    return failed != 0;
+} }
diff --git a/dm/gfx/tests/t_rc_zero.m b/dm/gfx/tests/t_rc_zero.m
new file mode 100644
index 00000000..beba617f
--- /dev/null
+++ b/dm/gfx/tests/t_rc_zero.m
@@ -0,0 +1,149 @@
+// DM_NVN_RC_GPU, first part (nvn_mtl.m rc_report_vis): a samples-passed report that follows a reset in the same submission with no counted draw between them is known 0 while
+// it is still pending, and each report keeps the visibility slots it sums. Run twice (check_t_rc_zero): DM_NVN_RC_GPU=0 and =1.
+// Real here: OP_RESET_COUNTER, OP_REPORT_COUNTER and OP_RENDER_COND through mtl_exec, the report table, the slot list (vis_slot_add), the post ops and post_run (the completion).
+// Stood in for: the counted pass (the two lines of draw_ that give it a slot), the visibility buffers (objects with a contents pointer) and the submission's end (the lines of
+// mtl_sub_commit that fold the slots, clear the reset flag and commit the report table). No Metal device is made: mtl_init is not called and nothing is encoded
+#include "game_profile.h"
+#undef DM_GAME_RENDER_COND
+#define DM_GAME_RENDER_COND 1
+#define nvn_game_fps nvn_game_fps_mtl_default
+#include "../nvn/nvn_mtl.m"
+#undef nvn_game_fps
+#define g_ft g_ft_hle
+#include "../nvn/hle_nvn.c"
+#undef g_ft
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+static const char *t_case = "";
+#define CHECK(c) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL line %d (%s): %s\n", __LINE__, t_case, #c); } } while (0)
+
+@interface StubBuf : NSObject { @public uint64_t v[64]; } @end
+@implementation StubBuf
+- (void *)contents { return v; }
+@end
+
+static uint64_t t_slots[8] __attribute__((aligned(16)));   // 16-byte report records: [0] the query's samples, [2] the reference the game compares it with (0), [4] a second query
+static uint64_t t_fence = 100;
+static StubBuf *t_ring, *t_over;   // the submission's ring buffer (ring entry 3) and an overflow buffer
+static void t_reset(void) {
+    struct { op_hdr h; uint64_t t; op_hdr e; } s = {{OP_RESET_COUNTER, 16}, NVN_COUNTER_TYPE_SAMPLES_PASSED, {OP_END, 8}};
+    mtl_exec((const uint8_t *)&s);
+}
+static void t_report(uint64_t addr) {
+    struct { op_hdr h; uint64_t t, ad; op_hdr e; } s = {{OP_REPORT_COUNTER, 24}, NVN_COUNTER_TYPE_SAMPLES_PASSED, addr, {OP_END, 8}};
+    mtl_exec((const uint8_t *)&s);
+}
+static void t_cond(int mode) {
+    struct { op_hdr h; p_render_cond c; op_hdr e; } s = {{OP_RENDER_COND, 8 + sizeof(p_render_cond)}, {mode, 0, (uintptr_t)t_slots}, {OP_END, 8}};
+    mtl_exec((const uint8_t *)&s);
+}
+// A counted pass takes a slot, as draw_ does; samples: what the GPU will have written there at completion
+static uint32_t t_counted(StubBuf *b, uint64_t samples) {
+    g_vis = (id)b;
+    g_vis_cur = (int)g_vis_n++; vis_slot_add();
+    b->v[g_vis_cur] = samples;
+    return (uint32_t)g_vis_cur;
+}
+static void t_begin(void) { g_npost = 0; g_vis_n = 0; g_vis_cur = -1; g_vis_ring_i = 3; g_vis = (id)t_ring; }   // a submission that has taken ring entry 3
+// The submission's end, the lines of mtl_sub_commit. Returns its fence
+static uint64_t t_commit(post_rec *r) {
+    uint64_t fence = ++t_fence;
+    if (g_nvs) { post((post_op){3, NULL, VIS_FOLD, 0, 0, 0, vis_snapshot()}); vis_clear(); }
+    g_vis_zero_here = 0;
+    rc_commit(fence);
+    int n = g_npost; post_op *ops = n ? malloc(n * sizeof *ops) : NULL; if (n) memcpy(ops, g_post, n * sizeof *ops);
+    *r = (post_rec){.n = n, .ops = ops}; atomic_store(&r->fence, fence);
+    return fence;
+}
+static void t_complete(post_rec *r) { CHECK(post_claim(r, r->fence)); post_run(r, 0, 0); }   // the GPU finished the submission
+typedef struct { uint64_t skip, draw, unknown, dropped, zero; } st;
+static st t_stats(void) { st s; mtl_rc_stats(&s.skip, &s.draw, &s.unknown, &s.dropped); s.zero = mtl_rc_zero(); return s; }
+// The condition "draw if not equal" on t_slots[0] against t_slots[2] (0), with the report pending. zero: it must be decided as a known 0 (not drawn); else it must stay unknown (drawn)
+static void t_pending_cond(int zero) {
+    uint64_t a = (uintptr_t)t_slots, x = 77; int l = 0; st s0 = t_stats();
+    CHECK(rc_pending_fence(a) != 0);   // committed, not complete
+    CHECK(rc_value_l(a, &x, &l) == zero); if (zero) CHECK(x == 0 && l == 2); else CHECK(l == 0);
+    t_cond(1);
+    st s1 = t_stats();
+    CHECK(g_rc_skip == zero); CHECK(!g_rcl_t.blk);
+    CHECK(s1.skip - s0.skip == (uint64_t)zero); CHECK(s1.unknown - s0.unknown == (uint64_t)!zero); CHECK(s1.draw == s0.draw); CHECK(s1.zero - s0.zero == (uint64_t)zero);
+    t_cond(2); CHECK(!g_rc_skip);
+}
+static const rc_report *t_rec(uint64_t addr) { return rc_find(addr); }
+int main(void) { @autoreleasepool {
+    const char *e = getenv("DM_NVN_RC_GPU"); int on = e && atoi(e);
+    g_vt = (id)[NSObject new];   // mtl_exec makes the argument tables when there is none: not here
+    g_sub_thread = pthread_self(); atomic_store(&g_sub_thread_set, 1);   // the translating thread is the replay thread
+    t_ring = [StubBuf new]; t_over = [StubBuf new]; g_vis_ring[3].buf = (id)t_ring; g_vis_ring_n = 4;
+    uint64_t a = (uintptr_t)t_slots, b = a + 32, x = 0; post_rec r; st s0, s1;
+    t_slots[2] = 0;
+
+    // (a) on, (c) off: reset; report with no counted draw. (e): the completion writes the 0 that was claimed
+    t_case = "reset, report, no counted draw"; t_begin(); t_slots[0] = 99;
+    t_reset(); CHECK(g_vis_zero_here == 1); t_report(a); CHECK(g_vis_zero_here == 0);
+    CHECK(t_rec(a)->gs_n == 0); CHECK(t_rec(a)->gzero == on);
+    x = 77; CHECK(rc_value(a, &x) == on); if (on) CHECK(x == 0);   // in its own submission too
+    t_commit(&r); CHECK(t_slots[0] == 99);
+    t_pending_cond(on);
+    t_complete(&r); CHECK(t_slots[0] == 0);
+    x = 77; int l = 0; CHECK(rc_value_l(a, &x, &l) && x == 0 && l == 0);   // landed: read from memory as before
+    s0 = t_stats(); t_cond(1); s1 = t_stats(); CHECK(g_rc_skip && s1.skip - s0.skip == 1 && s1.zero == s0.zero); t_cond(2);
+
+    // (b): reset; counted draw; report. One slot, in the ring buffer
+    t_case = "reset, counted draw, report"; t_begin(); t_slots[0] = 99;
+    t_reset(); uint32_t k0 = t_counted(t_ring, 7); t_report(a);
+    CHECK(t_rec(a)->gs_n == 1 && t_rec(a)->gs_ring[0] == 3 && t_rec(a)->gs_slot[0] == k0); CHECK(!t_rec(a)->gzero);
+    t_commit(&r); t_pending_cond(0);
+    t_complete(&r); CHECK(t_slots[0] == 7);
+    x = 0; CHECK(rc_value(a, &x) && x == 7);
+
+    // (d): a report with no reset before it in its submission: never known 0, not evaluable
+    t_case = "report, no reset in the submission"; t_begin(); t_slots[0] = 99;
+    t_report(a); CHECK(t_rec(a)->gs_n == 255 && !t_rec(a)->gzero);
+    t_commit(&r); t_pending_cond(0);
+    t_complete(&r); CHECK(t_slots[0] == 7);   // the running total goes on: 7 from the case before
+
+    // (d): the second report after one reset is not reset-based; the first is
+    t_case = "reset, report, report"; t_begin(); t_slots[0] = 99; t_slots[4] = 99;
+    t_reset(); t_report(b); t_report(a);
+    CHECK(t_rec(b)->gs_n == 0 && t_rec(b)->gzero == on); CHECK(t_rec(a)->gs_n == 255 && !t_rec(a)->gzero);
+    t_commit(&r); t_pending_cond(0);
+    t_complete(&r); CHECK(t_slots[0] == 0 && t_slots[4] == 0);
+
+    // (d): a reset in an earlier submission does not carry over
+    t_case = "reset in the submission before"; t_begin(); t_reset(); t_commit(&r); t_complete(&r);
+    t_begin(); t_slots[0] = 99; t_report(a); CHECK(t_rec(a)->gs_n == 255 && !t_rec(a)->gzero);
+    t_commit(&r); t_pending_cond(0); t_complete(&r); CHECK(t_slots[0] == 0);
+
+    // a known 0 is replaced by the next report of the address
+    t_case = "known 0, then reported again"; t_begin(); t_slots[0] = 99;
+    t_reset(); t_report(a); CHECK(t_rec(a)->gzero == on); uint32_t k1 = t_counted(t_ring, 5); t_report(a);
+    CHECK(!t_rec(a)->gzero && t_rec(a)->gs_n == 255); x = 77; CHECK(!rc_value(a, &x));
+    t_commit(&r); t_pending_cond(0); t_complete(&r); CHECK(t_slots[0] == 5); (void)k1;
+
+    // a submission with workers' pieces: their slots are not in this thread's list, so nothing is claimed
+    t_case = "replay thread of a submission with workers"; t_begin(); t_slots[0] = 99; g_pcx_role = 1;
+    t_reset(); t_report(a); g_pcx_role = 0; CHECK(t_rec(a)->gs_n == 255 && !t_rec(a)->gzero);
+    t_commit(&r); t_pending_cond(0); t_complete(&r); CHECK(t_slots[0] == 0);
+
+    // (f): the slot record with 2 and 3 slots, and with a slot in an overflow buffer
+    t_case = "two slots"; t_begin(); t_reset(); uint32_t k2 = t_counted(t_ring, 1), k3 = t_counted(t_ring, 2); t_report(a);
+    CHECK(t_rec(a)->gs_n == 2 && t_rec(a)->gs_ring[0] == 3 && t_rec(a)->gs_ring[1] == 3 && t_rec(a)->gs_slot[0] == k2 && t_rec(a)->gs_slot[1] == k3 && k2 != k3);
+    t_commit(&r); t_pending_cond(0); t_complete(&r); CHECK(t_slots[0] == 3);
+    t_case = "three slots"; t_begin(); t_reset(); t_counted(t_ring, 1); t_counted(t_ring, 1); t_counted(t_ring, 1); t_report(a);
+    CHECK(t_rec(a)->gs_n == 255 && !t_rec(a)->gzero);
+    t_commit(&r); t_pending_cond(0); t_complete(&r); CHECK(t_slots[0] == 3);
+    t_case = "a slot in an overflow buffer"; t_begin(); t_reset(); t_counted(t_ring, 4); g_vis_n = 0; t_counted(t_over, 6); t_report(a);
+    CHECK(t_rec(a)->gs_n == 255 && !t_rec(a)->gzero);
+    t_commit(&r); t_pending_cond(0); t_complete(&r); CHECK(t_slots[0] == 10);
+    t_case = "one slot, no ring buffer taken"; t_begin(); g_vis_ring_i = -1; t_reset(); t_counted(t_over, 2); t_report(a);
+    CHECK(t_rec(a)->gs_n == 255);
+    t_commit(&r); t_complete(&r); CHECK(t_slots[0] == 2);
+
+    printf("t_rc_zero: DM_NVN_RC_GPU=%d: %d checks, %d failed\n", on, checks, failed);
+    return failed != 0;
+} }
